{
 "__inputs": [
  {
   "name": "DS_LOKI",
   "label": "Loki",
   "description": "Loki that Alloy writes the nginx logs to",
   "type": "datasource",
   "pluginId": "loki",
   "pluginName": "Loki"
  }
 ],
 "title": "nginx per site",
 "uid": "nginx-per-site",
 "tags": [
  "nginx"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "site",
    "label": "Site",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "${DS_LOKI}"
    },
    "query": {
     "label": "site",
     "stream": "{job=\"nginx\"}",
     "type": 1
    },
    "definition": "label_values({job=\"nginx\"},site)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Requests",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "sum(count_over_time({job=\"nginx\",site=~\"$site\"} [$__range]))",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "5xx (errors)",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "sum(count_over_time({job=\"nginx\",site=~\"$site\",status=~\"5..\"} [$__range]))",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "429 (rate limited)",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "sum(count_over_time({job=\"nginx\",site=~\"$site\",status=\"429\"} [$__range]))",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Cache hit ratio (cached locations)",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "sum(count_over_time({job=\"nginx\",site=~\"$site\"} |~ \"cache=HIT|cache=STALE\" [$__range])) / sum(count_over_time({job=\"nginx\",site=~\"$site\"} |~ \"cache=(HIT|MISS|EXPIRED|STALE|UPDATING|REVALIDATED)\" [$__range]))",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Requests per second",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "sum by (site) (rate({job=\"nginx\",site=~\"$site\"} [$__auto]))",
     "legendFormat": "{{site}}",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Status 5xx and 429 per minute",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "sum by (status) (count_over_time({job=\"nginx\",site=~\"$site\",status=~\"5..|429\"} [1m]))",
     "legendFormat": "{{status}}",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Response time p95 (s)",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "quantile_over_time(0.95, {job=\"nginx\",site=~\"$site\"} | regexp `rt=(?P<rt>[0-9.]+)` | unwrap rt [$__auto]) by (site)",
     "legendFormat": "{{site}}",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Upstream (backend) time p95 (s)",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "quantile_over_time(0.95, {job=\"nginx\",site=~\"$site\"} | regexp `urt=\"(?P<urt>[0-9.]+)\"` | unwrap urt [$__auto]) by (site)",
     "legendFormat": "{{site}}",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Cache result per minute",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "sum by (c) (count_over_time({job=\"nginx\",site=~\"$site\"} | regexp `cache=(?P<c>[A-Z]+)` [1m]))",
     "legendFormat": "{{c}}",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Slow requests (rt over 2 s) per minute",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "sum by (site) (count_over_time({job=\"nginx\",site=~\"$site\"} | regexp `rt=(?P<rt>[0-9.]+)` | rt > 2 [1m]))",
     "legendFormat": "{{site}}",
     "queryType": "range"
    }
   ]
  }
 ]
}