#!/usr/bin/env bash
# Oeffnet die Textoberflaeche fuer die Schluessel der Partner-API (Backend/scripts/partner-keys-tui.ts).
# Wird bei jedem Deploy nach /usr/local/bin/dpsmeter_keys kopiert; Aufruf: ssh -t alfahosting dpsmeter_keys
set -euo pipefail
if [[ "$EUID" -ne 0 ]]; then
  echo "dpsmeter_keys muss als root laufen." >&2
  exit 1
fi
if [[ ! -t 0 ]]; then
  echo "Braucht ein Terminal: ssh -t alfahosting dpsmeter_keys" >&2
  exit 1
fi
exec su - aion-dpsmeter -s /bin/bash -c 'cd /opt/dpsmeter/Backend && pnpm --silent partner-keys'
