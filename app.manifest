<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="AionSniffer.app"/>

  <!-- asInvoker on purpose, even though the meter wants admin rights: requireAdministrator here
       would put a UAC prompt in front of EVERY invocation, including the console modes
       (selftest / chatlog / devices) that need no privileges at all and are run repeatedly while
       developing. Program.Main instead re-launches itself elevated when, and only when, it is
       opening the GUI - so a shortcut, a double-click and the installer's Start-menu entry all
       end up running as administrator, while the CLI stays promptless. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Without this block Windows reports 6.2 for every later version, which is what the
       framework's own default manifest declares; kept in sync with net10.0-windows' supported set
       (Windows 7 through 11/Server 2022). -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
