<Window x:Class="AionDPS.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionDPS.Ui"
        Title="Aion DPS" Height="492" Width="357"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontSize="{DynamicResource FontSize.Base}">
    <Window.Resources>
        <!-- All in One mode: the heal column reads green and the damage-taken column red, in the
             window's rows (muted grey otherwise), the chips and the compact panel (subtle otherwise). -->
        <!-- The secondary numbers (rate, damage taken) sit on the row's class colour: light text at 80 % reads
             there, the muted grey did not. -->
        <Style x:Key="AllHealMuted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Style.Triggers><DataTrigger Binding="{Binding AllMode}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Heal}"/><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AllTakenMuted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Style.Triggers><DataTrigger Binding="{Binding AllMode}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.DangerSoft}"/><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AllHealSubtle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}"/>
            <Style.Triggers><DataTrigger Binding="{Binding AllMode}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Heal}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AllTakenSubtle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}"/>
            <Style.Triggers><DataTrigger Binding="{Binding AllMode}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.DangerSoft}"/></DataTrigger></Style.Triggers>
        </Style>
        <local:ClassIconConverter x:Key="ClassIconConverter"/>
        <local:RaceIconConverter x:Key="RaceIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- ShareBar (share-of-group bar under a row's Damage/DPS line, PlayerRow.SharePercent)
             now lives in Ui/Styles/Shared.xaml, merged into Application.Resources in Program.cs -
             PlayerDetailsWindow's skill table needs the same style, and duplicating a
             ControlTemplate per window invites the two copies drifting apart. -->
        <!-- Found by the user (left nav rail looked bright/white), then found AGAIN by
             terminal_windows measuring actual rendered pixels after the first fix: BasedOn alone
             fixed enabled buttons, but the four disabled nav buttons still rendered #F4F4F4 -
             WPF's default ButtonChrome template has its own IsEnabled=False trigger that sets a
             light background, and a template trigger always wins over a Style setter, inherited
             or not. Setters can never out-rank the default template's own triggers; only
             replacing the template does. Full custom template below: a plain Border + trigger for
             hover/pressed/disabled, so disabled means "dimmed", not "WPF's stock light chrome". -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Window}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- NavButton (below) is a keyed style with no BasedOn, so it replaces the implicit
             Button style above entirely instead of adding to it - it only ever set
             Width/Height/Margin, leaving colors/template at WPF's defaults. BasedOn fixes it. -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <!-- Per the user: the Copy/CopyAll/Pause/Clear/HideUi icon row (shared by the
             Damage and Loot views) sat only one shade above the toolbar's own #26262e background
             (#2a2a33 idle), which barely separated the icon chips from their surroundings. A full
             template copy rather than a BasedOn override of just the Background setter: the
             default Button template's hover/pressed colors (#34343f/#1e1e24) are hardcoded inside
             its ControlTemplate.Triggers, not TemplateBinding'd, so a lighter idle color alone
             would leave hover barely distinguishable from idle (or, worse, darker than it). -->
        <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ControlHoverStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Panel}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- PVE/PVP mode switch, per the user: not an independent checkbox but a two-way segmented
             toggle where exactly one side is active - PveModeButton starts IsChecked in the XAML
             below, and OnPvpModeToggleClicked keeps the pair mutually exclusive in code (plain
             ToggleButtons rather than RadioButtons, since only two segments ever exist and this
             keeps the "which one is active" logic in one small method instead of fighting
             RadioButton's own default chrome). The checked segment gets the same green (#69e15e)
             already used for this app's other accent/link text, dark text on top of it for contrast
             (mirrors a filled button on a light background, not this app's usual light-on-dark). -->
        <Style x:Key="PvpModeToggleLeft" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.ControlHover}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,1,0,1"
                                CornerRadius="4,0,0,4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Toggle}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Window}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ControlHoverStrong}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PvpModeToggleRight" TargetType="ToggleButton" BasedOn="{StaticResource PvpModeToggleLeft}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.ControlHover}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="0,4,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Toggle}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Window}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ControlHoverStrong}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Same root cause, different control: an implicit ComboBox style only setting
             Margin/MinWidth does nothing to the default WPF chrome, which is light-themed
             regardless of the window's own colors (the closed box AND, worse, the dropdown
             popup - a bright white list floating over a dark window). Setting Background/
             Foreground alone does not fix a ComboBox the way it does a Button, because the
             default ComboBox ControlTemplate does not consistently use those properties for its
             chrome; only a full template replacement reliably does. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Found by the user from a screenshot after the ComboBox/NavButton fix: the DataGrid's
             column header row was still bright white - unlike ComboBox, DataGridColumnHeader's
             default template DOES respect a plain Background/Foreground/BorderBrush setter, it
             just never had one set in the first place. -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
                <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="MinWidth" Value="110"/>
            <!-- Per the user: the closed box previously matched the surrounding toolbar/window
                 background (#26262e) almost exactly, so the three filter dropdowns barely read as
                 controls. A distinct, still-dark shade here - the dropdown POPUP below keeps
                 #26262e on purpose, so the open list still matches the rest of the app's flyouts. -->
            <Setter Property="Background" Value="{DynamicResource Brush.ControlRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource Brush.TextSubtle}" Margin="0,0,8,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,3,20,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Per the user: the Mob/Boss target dropdown needed a search box, filtering the list as
             you type by substring ("like '%word%'"), not just WPF's own built-in type-ahead (which
             only matches from the start of an item's text). A ComboBox's normal IsEditable="True"
             would need this template to define a PART_EditableTextBox, replacing the closed box's
             own display - not what's wanted here, since the closed box should keep showing the
             CURRENT SELECTION, not become a typing field itself. Instead, PART_SearchBox lives
             inside the dropdown POPUP, above the list, exactly where MainWindow.xaml.cs's
             ApplyMobBossSearchFilter expects to find it (via Template.FindName, wired up once in
             OnWindowLoaded) - it only affects what the OPEN list shows, never the closed box. -->
        <Style x:Key="SearchableComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource Brush.TextSubtle}" Margin="0,0,8,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,3,20,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <!-- The list is wider than the closed box (which stays narrow next to the other dropdowns), so a whole boss name can be read. -->
                                <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        MinWidth="300">
                                    <DockPanel>
                                        <TextBox x:Name="PART_SearchBox" DockPanel.Dock="Top"
                                                 Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
                                                 BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                                 Padding="5,4" Margin="0"/>
                                        <ScrollViewer SnapsToDevicePixels="True" MaxHeight="240">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Found by the user from a screenshot: opening a menu (e.g. "Mode") dropped a bright
             white submenu popup. The Menu bar itself already looked dark because its own
             Background was set directly in the XAML below, but a submenu's popup is a separate
             visual tree that draws from SystemColors.Menu*, not from that Background property -
             same family of bug as the ComboBox/DataGrid/ListBox fixes above, different keys.
             Scoped to Window.Resources (not the Menu element) because these specific keys don't
             overlap with the Highlight* keys already scoped to the DataGrid/ListBox, so there's
             no risk of the two fixes fighting each other. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{DynamicResource Color.Panel}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{DynamicResource Color.Text}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="{DynamicResource Color.Border}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{DynamicResource Color.Panel}"/>
        <!-- Found by the user: menu items rendered with an ugly per-item border/bevel. Same
             lesson as Button/ComboBox/CheckBox before it - a Background/Foreground setter alone
             leaves whatever border/bevel chrome the default MenuItem template draws untouched;
             only replacing the template removes it. One template covers top-level headers (App,
             Session, Settings, Mode), leaf items with no children (Close, Check for updates, ...), and
             submenu entries - WPF's MenuItem is the same class for all three, distinguished only
             by its Role property, which the Popup.Placement trigger below accounts for. -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Check" Grid.Column="0" Data="M 2,7 L 6,11 L 12,3" Stroke="{DynamicResource Brush.Text}"
                                          StrokeThickness="1.6" Margin="0,0,8,0" Visibility="Collapsed"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="Popup" Property="Placement" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- App-Menü A ("Flyout-Karte", vom User gebilligter Prototyp): shared row style for both
             the plain-action Buttons and the two expandable-group ToggleButtons below (ButtonBase
             covers both). Kept separate from the plain global Button style further up so it never
             leaks its rounded/hover chrome onto ordinary buttons elsewhere in the window. -->
        <Style x:Key="AppMenuRow" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1f3141"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Only the "App" MenuItem gets this - Session/Settings/Mode keep the plain global
             MenuItem style above (real WPF submenus, keyboard nav intact). Popup content is
             hand-authored (Border+StackPanel), not <ItemsPresenter/>, because the rows below are
             plain Buttons/ToggleButtons, not child MenuItems - see the "App" MenuItem itself for
             why (its 14 child MenuItems were replaced by this). Colors here are deliberately
             hard-coded navy/orange, not {DynamicResource Brush.*} - per the user, who chose this
             over matching the current app theme (no theme's own accent is orange). No logo/
             version/close header like the standalone design prototype had: this window already
             draws both in its own titlebar just above, a second copy here would be redundant. -->
        <Style x:Key="AppMenuFlyoutStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#152532" BorderBrush="#294557" BorderThickness="1" CornerRadius="10" Width="260">
                                    <StackPanel Margin="6">
                                        <!-- Uploads: at the very top (moved here from the Session menu). Shown by the same rules as
                                             before (RefreshUploadAvailability); the flags live in AppMenu.Tag, since a template part
                                             has no field of its own in the code-behind. -->
                                        <Button Style="{StaticResource AppMenuRow}" Click="OnUploadCurrentBossClicked"
                                                Visibility="{Binding Tag.ShowBoss, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Uploads the fight currently selected in the Mob/Boss filter to aiondps.com.">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M6,11 L6,3 M3,6 L6,3 L9,6 M1,13 L11,13" Stroke="#FFBA42" StrokeThickness="1.4" Width="14" Height="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Loc Main.MenuSession.UploadBoss}" Foreground="#f2f5f7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource AppMenuRow}" Click="OnUploadLastRunClicked"
                                                Visibility="{Binding Tag.ShowRun, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Uploads every boss fight recorded since the last Clear, one by one, to aiondps.com.">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M6,11 L6,3 M3,6 L6,3 L9,6 M1,13 L11,13" Stroke="#FFBA42" StrokeThickness="1.4" Width="14" Height="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Loc Main.MenuSession.UploadRun}" Foreground="#f2f5f7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Border Height="1" Background="#21374a" Margin="4,6"
                                                Visibility="{Binding Tag.ShowAny, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Verbindung zurücksetzen: still IsEnabled=False today. -->
                                        <StackPanel Orientation="Horizontal" Margin="8,5">
                                            <Path Data="M2,2 L5,5 M9,9 L12,12 M2,12 L5,9 M9,5 L12,2" Stroke="#5c6b74" StrokeThickness="1.3" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="{local:Loc Main.MenuApp.ResetConnection}" Foreground="#5c6b74" VerticalAlignment="Center" FontSize="11.5"/>
                                        </StackPanel>

                                        <!-- Ansicht leeren: real action - same red-X path the toolbar's
                                             own ClearButton already draws (OnClearClicked), so the two
                                             stay visually identical instead of drifting apart. -->
                                        <Button Style="{StaticResource AppMenuRow}" Click="OnClearClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M4,3 L14,13 M14,3 L4,13" Stroke="#ff5a4f" StrokeThickness="1.8" Width="14" Height="10" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Loc Main.MenuApp.ClearCurrentView}" Foreground="#f2f5f7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Border Height="1" Background="#21374a" Margin="4,6"/>

                                        <!-- Nach Updates suchen: real action (OnCheckForUpdatesClicked). -->
                                        <Button Style="{StaticResource AppMenuRow}" Click="OnCheckForUpdatesClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M7,1 L7,8 M3,6 L7,10 L11,6 M2,12 L12,12" Stroke="#9db3c2" StrokeThickness="1.3" Width="14" Height="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Loc Main.MenuApp.CheckForUpdates}" Foreground="#f2f5f7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- In den Infobereich minimieren: real action (OnMinimizeToTrayClicked,
                                             TrayIcon.cs) - a momentary click (hide now), not a persisted
                                             setting like the toggle above, so a plain Button/row like the
                                             other real actions rather than another checkmark row. -->
                                        <Button Style="{StaticResource AppMenuRow}" Click="OnMinimizeToTrayClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M2,3 L12,3 L12,10 L2,10 Z M2,8 L12,8" Stroke="#9db3c2" StrokeThickness="1.3" Width="14" Height="10" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Loc Main.MenuApp.MinimizeToTray}" Foreground="#f2f5f7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Client neu starten: keeps the running session (see OnRestartClientClicked). -->
                                        <Button Style="{StaticResource AppMenuRow}" Click="OnRestartClientClicked"
                                                ToolTip="Restarts the meter and keeps the current session: it is written to a temp file and read back on start.">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M12,7 A5,5 0 1 1 9.5,2.7 M9,1 L10,3.2 L7.8,4" Stroke="#9db3c2" StrokeThickness="1.3" Width="14" Height="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Loc Main.MenuApp.RestartClient}" Foreground="#f2f5f7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Border Height="1" Background="#21374a" Margin="4,6"/>

                                        <!-- Beenden: real action (OnCloseClicked, the same one the
                                             titlebar's own ✕ button already calls) - danger-colored, its
                                             own row rather than the standalone prototype's separate
                                             brand-wordmark footer (redundant here, see the Style's own
                                             remarks above). -->
                                        <Button Style="{StaticResource AppMenuRow}" Click="OnCloseClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M6,1 L2,1 L2,13 L6,13 M10,4 L13,7 L10,10 M13,7 L5,7" Stroke="#ff8a7d" StrokeThickness="1.4" Width="14" Height="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="{local:Loc Main.MenuApp.Close}" Foreground="#ff8a7d" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A separator in a menu: one thin line over the whole width of the menu (the default one is indented for an icon column and ends short). -->
        <ControlTemplate x:Key="MenuSeparatorLine" TargetType="Separator">
            <Border Height="1" Margin="6,4" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Border}"/>
        </ControlTemplate>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template" Value="{StaticResource MenuSeparatorLine}"/>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}"/>
        <!-- Found by the user: a ToolTip popup (e.g. the Char-quick-switch's, back when it still
             existed) rendered as a bright white box - same popup-chrome issue as everything above, ToolTip's default template
             ignores Background/Foreground the same way. Simple setters ARE enough here (ToolTip's
             default template is a plain bordered box, no bevel/3D chrome to fight). -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <!-- Found by terminal_windows measuring pixels again: a CheckBox's own box (the now-removed
             PlayersOnlyFilter toggle, back when it still existed) drew pure white - the same family
             of bug as the disabled-Button chrome earlier, a Foreground setter never reaches the box,
             only its default template does. Full template: a small dark Border for the box, a
             checkmark Path shown only when checked. Kept for the CheckBoxes still in this window's
             menus and any future toggle. -->
        <Style TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="14" Height="14" Background="{DynamicResource Brush.Panel}"
                                    BorderBrush="{DynamicResource Brush.CheckBorder}" BorderThickness="1" Margin="0,0,6,0">
                                <Path x:Name="Check" Data="M 2,7 L 6,11 L 12,3" Stroke="{DynamicResource Brush.Text}"
                                      StrokeThickness="1.6" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.CheckBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ================= Normal mode ================= -->
        <!-- WindowStyle="None" on the Window (needed so "Hide UI" can make the whole surface
             transparent+click-through) means there's no OS titlebar - this Border supplies its
             own dark background (so normal mode looks the way it always did) plus a manual
             drag/close bar, since we gave up the OS one. -->
        <Border x:Name="NormalContent" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Background="{DynamicResource Brush.TitleBar}" Height="30" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <!-- The real app icon (assets/app/aiondps.ico, also ApplicationIcon in the
                         .csproj - see its remarks) - per the user, who noticed this corner still
                         showed the placeholder navy/orange accent chip from before the icon
                         existed, not the actual logo shown everywhere else (taskbar, installer,
                         Settings' OS titlebar). Purely decorative here too (no click target), same
                         as the chip it replaces. Source set in code-behind (OnWindowLoaded), not
                         here - a plain pack://siteoforigin Source on this Image silently rendered
                         nothing at all for this specific .ico, unlike the PNG icons elsewhere in
                         this app; System.Drawing.Icon + CreateBitmapSourceFromHIcon is the same
                         battle-tested decode path Explorer itself uses for any .ico. -->
                    <Image x:Name="AppIconImage" Width="16" Height="16"
                           Margin="8,0,0,0" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- Per the user: the version belongs where it's actually seen. Window.Title
                         already carries it (set in the constructor from AppVersion.Text, see its
                         remarks on why a screenshot needs to identify its build), but WindowStyle=
                         "None" means the OS never draws that text anywhere; this hand-drawn bar is
                         the only titlebar a user ever sees, so it has to show the same string
                         rather than a second, separately-hardcoded one that could drift from it. -->
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="30,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Missing until now: with WindowStyle="None" there was no way at all to
                             minimize from the UI (no OS chrome draws one either). Per the reference
                             layout's window-action row. -->
                        <Button Click="OnMinimizeClicked" Width="28" Height="30" Padding="0"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextMuted}" Margin="0">
                            <Path Data="M1,6 L11,6" Width="12" Height="12" Stretch="None" StrokeThickness="1.4" SnapsToDevicePixels="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Brush.TextMuted}"/>
                        </Button>
                        <Button Click="OnCloseClicked" Width="28" Height="30" Padding="0"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextMuted}" Margin="0">
                            <Path Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" Width="12" Height="12" Stretch="None" StrokeThickness="1.4" SnapsToDevicePixels="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Brush.TextMuted}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Top menu bar: App / Session / Settings / Mode. The original
                     App/Session/Mode set matched the myaion.eu reference; Settings was
                     split out of App into its own dropdown per the user's request, since App had
                     grown into one long grab-bag of session/dev/settings items with no fixed place
                     to look for any one of them. Load/Save Session, both folder buttons, Start
                     with Windows and Minimize to tray were placeholders for a while (explicit ask
                     needed first for the Windows-Run-key/tray-icon ones specifically) - given by
                     the user, and all four are real now (SessionFile.cs, StartupRegistration.cs,
                     TrayIcon.cs). Reset Connection is still the one remaining placeholder row. -->
                <!-- Menu bar: the menus on the left, the PVE/PVP switch at the far right. -->
                <Grid DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Menu Grid.Column="0" Background="Transparent" Foreground="{DynamicResource Brush.Text}">
                    <!-- App-Menü A ("Flyout-Karte", vom User gebilligt): all 14 child MenuItems that
                         used to live here (Load/SaveSession, Export/ValidateSession, both folder
                         items, ResetConnection, ClearCurrentView,
                         CheckForUpdates, MinimizeToTray, Close)
                         moved into AppMenuFlyoutStyle's own hand-authored Popup content above -
                         same Click targets, same {local:Loc} keys (muted rows instead of
                         greyed-out MenuItems for whichever were still placeholders at the time -
                         see that Popup content's own remarks for which still are). Nothing here
                         needs children anymore since the Popup no longer renders via
                         <ItemsPresenter/>. -->
                    <MenuItem x:Name="AppMenu" Header="{local:Loc Main.MenuApp}" Foreground="{DynamicResource Brush.Text}"
                              Style="{StaticResource AppMenuFlyoutStyle}" Click="OnAppMenuClicked"/>
                    <!-- The session list is built in code each time the menu opens (SessionMenu_SubmenuOpened): "All", the stay the
                         player is in now, and the last few finished ones. The uploads that used to sit here are at the top of the App menu. -->
                    <MenuItem x:Name="SessionMenu" Header="{local:Loc Main.MenuSession}" Foreground="{DynamicResource Brush.Text}"
                              SubmenuOpened="OnSessionMenuOpened">
                        <!-- Placeholder: a MenuItem without children is a leaf and never raises SubmenuOpened; the handler replaces it. -->
                        <MenuItem Header="..." IsEnabled="False"/>
                    </MenuItem>
                    <!-- Consolidated here from the App menu, per the user's request - App had
                         become a long, mixed grab-bag of session/dev/settings items; splitting
                         out everything settings-related into its own top-level dropdown (right of
                         Session) makes it a fixed, predictable place to look, rather than one more
                         entry buried among a dozen others. -->
                    <!-- Tools: the combat analyzer (session manager), loading/saving/exporting sessions and the dummy test. The session part comes first,
                         a line sets the dummy test apart. -->
                                        <MenuItem x:Name="ToolsMenu" Header="{local:Loc Main.MenuTools}" Foreground="{DynamicResource Brush.Text}">
                        <MenuItem Header="{local:Loc Main.MenuTools.Checklist}" Tag="checklist" Click="OnOpenModuleClicked"/>
                        <MenuItem Header="{local:Loc Main.MenuTools.Attributes}" Tag="attributes" Click="OnOpenModuleClicked"/>
                        <MenuItem Header="{local:Loc Main.MenuTools.StatCalc}" Tag="statcalc" Click="OnOpenModuleClicked"/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Main.MenuTools.Loot}" Tag="loot" Click="OnOpenModuleClicked"/>
                        <MenuItem Header="{local:Loc Main.MenuTools.Craft}" Tag="craft" Click="OnOpenModuleClicked"/>
                        <MenuItem Header="{local:Loc Settings.Nav.PetMap}" Tag="petmap" Click="OnOpenModuleClicked"/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Settings.Nav.Combat}" Tag="combat" Click="OnOpenModuleClicked"/>
                        <MenuItem Header="{local:Loc Main.MenuTools.Assist}" Tag="assist" Click="OnOpenModuleClicked"/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Main.MenuTools.DummyTest}" Tag="dummy" Click="OnOpenModuleClicked"/>
                        <MenuItem Header="{local:Loc Main.MenuTools.Analyzer}" Tag="analyzer" Click="OnOpenModuleClicked"/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Settings.Nav.Timetable}" Tag="timetable" Click="OnOpenModuleClicked"/>
                        <MenuItem Header="{local:Loc Settings.Nav.Boss}" Tag="boss" Click="OnOpenModuleClicked"/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Main.MenuTools.ThemeEditor}" Tag="theme" Click="OnOpenModuleClicked"/>
                        <MenuItem Header="{local:Loc Main.MenuTools.Stream}" Tag="stream" Click="OnOpenModuleClicked"/>
                        <MenuItem Header="{local:Loc Settings.Nav.Network}" Tag="network" Click="OnOpenModuleClicked"/>
                    </MenuItem>
                    <MenuItem Header="{local:Loc Main.MenuSettings}" Foreground="{DynamicResource Brush.Text}">
                        <MenuItem Header="{local:Loc Main.MenuSettings.AppSettings}" Click="OnSettingsClicked"/>
                        <MenuItem x:Name="AlwaysOnTopMenuItem" Header="{local:Loc Main.MenuSettings.AlwaysOnTop}" IsCheckable="True" Click="OnAlwaysOnTopClicked"/>
                        <MenuItem Header="{local:Loc Main.MenuSettings.Feedback}" Click="OnFeedbackClicked"/>
                    </MenuItem>
                </Menu>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,2,6,2" VerticalAlignment="Center"
                                ToolTip="PVE: damage against mobs/bosses (default). PVP: damage against other players only - Arena/Abyss/GvG.">
                        <ToggleButton x:Name="PveModeButton" Style="{StaticResource PvpModeToggleLeft}"
                                      Content="{local:Loc Main.ModePve}" IsChecked="True" Click="OnPvpModeToggleClicked"/>
                        <ToggleButton x:Name="PvpModeButton" Style="{StaticResource PvpModeToggleRight}"
                                      Content="{local:Loc Main.ModePvp}" Click="OnPvpModeToggleClicked"/>
                    </StackPanel>
                </Grid>

                <!-- Top toolbar: matches MyAion's Copy / Copy All / Pause / Clear row. All are
                     icon-only per the user's request ("... alle mit Tooltip bitte") - each ToolTip
                     is the only remaining explanation of what a button does. Copy/CopyAll use an
                     overlapping-rectangles glyph (2 rects for Copy, 3 for CopyAll, to visually hint
                     "more"); the back rect(s) are given the toolbar's own Background as Fill so the
                     front rect's edge reads as an overlap rather than a plus-sign of crossing
                     lines. A Grid, not a plain StackPanel, so the PVE/PVP toggle can sit flush
                     right (Grid.Column="2") instead of just trailing whatever the icons' own widths
                     leave - per the user. Hide UI (the eye icon) moved out of this row entirely,
                     down to the nav row below, next to Upload. -->
                <Grid DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Icon vs text label toggled per view (see OnShowDamageView/OnShowLootView)
                         - per the user: while the Loot view is active, Copy and CopyAll produce
                         genuinely different payloads (chat string vs Discord table, see
                         OnCopyClicked/OnCopyAllClicked) and a generic icon no longer says which is
                         which. The Damage view still shows the plain icon, though its two buttons
                         now differ as well (chat string vs tab-separated table). Left as-is
                         because the user asked only for the missing payload, not a toolbar
                         change; showing the labels there too would apply the same reasoning. -->
                    <!-- Same two buttons in both views, per the user: an "A" for the chat string
                         and Discord's own mark for the table. They used to swap between an icon and
                         a text label depending on the active view, which meant the same button
                         looked like two different controls. -->
                    <Button x:Name="CopyButton" Style="{StaticResource ToolbarIconButton}" Click="OnCopyClicked" Padding="5"
                            ToolTip="Copy a one-line chat string - the damage ranking, or an Aion-chat loot summary if the Loot view is active.">
                        <Grid Width="18" Height="16">
                            <TextBlock Text="A" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <!-- The pair differs by FORMAT, not by row selection: both cover the rows the
                         grid is showing (no per-source filter exists yet for "all" to differ from
                         "visible"), but Copy yields the one-line chat string and CopyAll the
                         tab-separated table, which is what the String/Table labels say. -->
                    <Button x:Name="CopyAllButton" Style="{StaticResource ToolbarIconButton}" Click="OnCopyAllClicked" Padding="5"
                            ToolTip="Copy an ASCII table in a code block, ready to paste into Discord - damage, or loot if the Loot view is active.">
                        <Grid Width="18" Height="16">
                            <!-- Discord's own mark, from the simple-icons 24x24 viewBox. The SVG
                                 packs arc flags ("0 0 0-4.88"), which WPF's geometry parser rejects,
                                 so the flags are spaced out and bare ".5" numbers are written "0.5".
                                 SelfCheck parses this string, because a malformed Data attribute
                                 throws while the window is being built - the app would not start. -->
                            <Path Data="M 20.317 4.3698a 19.7913 19.7913 0 0 0 -4.8851 -1.5152 0.0741 0.0741 0 0 0 -0.0785 0.0371c -0.211 0.3753 -0.4447 0.8648 -0.6083 1.2495 -1.8447 -0.2762 -3.68 -0.2762 -5.4868 0 -0.1636 -0.3933 -0.4058 -0.8742 -0.6177 -1.2495a 0.077 0.077 0 0 0 -0.0785 -0.037 19.7363 19.7363 0 0 0 -4.8852 1.515 0.0699 0.0699 0 0 0 -0.0321 0.0277C 0.5334 9.0458 -0.319 13.5799 0.0992 18.0578a 0.0824 0.0824 0 0 0 0.0312 0.0561c 2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a 0.0777 0.0777 0 0 0 0.0842 -0.0276c 0.4616 -0.6304 0.8731 -1.2952 1.226 -1.9942a 0.076 0.076 0 0 0 -0.0416 -0.1057c -0.6528 -0.2476 -1.2743 -0.5495 -1.8722 -0.8923a 0.077 0.077 0 0 1 -0.0076 -0.1277c 0.1258 -0.0943 0.2517 -0.1923 0.3718 -0.2914a 0.0743 0.0743 0 0 1 0.0776 -0.0105c 3.9278 1.7933 8.18 1.7933 12.0614 0a 0.0739 0.0739 0 0 1 0.0785 0.0095c 0.1202 0.099 0.246 0.1981 0.3728 0.2924a 0.077 0.077 0 0 1 -0.0066 0.1276 12.2986 12.2986 0 0 1 -1.873 0.8914 0.0766 0.0766 0 0 0 -0.0407 0.1067c 0.3604 0.698 0.7719 1.3628 1.225 1.9932a 0.076 0.076 0 0 0 0.0842 0.0286c 1.961 -0.6067 3.9495 -1.5219 6.0023 -3.0294a 0.077 0.077 0 0 0 0.0313 -0.0552c 0.5004 -5.177 -0.8382 -9.6739 -3.5485 -13.6604a 0.061 0.061 0 0 0 -0.0312 -0.0286zM 8.02 15.3312c -1.1825 0 -2.1569 -1.0857 -2.1569 -2.419 0 -1.3332 0.9555 -2.4189 2.157 -2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332 -0.9555 2.4189 -2.1569 2.4189zm 7.9748 0c -1.1825 0 -2.1569 -1.0857 -2.1569 -2.419 0 -1.3332 0.9554 -2.4189 2.1569 -2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332 -0.946 2.4189 -2.1568 2.4189Z"
                                  Fill="{DynamicResource Brush.Text}" Stretch="Uniform" Width="16" Height="16"/>
                        </Grid>
                    </Button>
                    <!-- Pause/Resume: one button, two overlaid glyphs (pause bars / play triangle)
                         with only one Visible at a time - toggled in OnPauseClicked alongside the
                         ToolTip text, since the icon alone no longer carries the word "Resume".
                         Paused combat data is discarded, never replayed on Resume. -->
                    <Button x:Name="PauseButton" Style="{StaticResource ToolbarIconButton}" Click="OnPauseClicked" Padding="5"
                            ToolTip="Pause recording.">
                        <Grid Width="18" Height="16">
                            <StackPanel x:Name="PauseIcon" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="4" Height="14" Fill="{DynamicResource Brush.Text}" Margin="0,0,3,0"/>
                                <Rectangle Width="4" Height="14" Fill="{DynamicResource Brush.Text}"/>
                            </StackPanel>
                            <Path x:Name="PlayIcon" Data="M3,1 L3,15 L15,8 Z" Fill="{DynamicResource Brush.Text}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ClearButton" Style="{StaticResource ToolbarIconButton}" Click="OnClearClicked" Padding="5"
                            ToolTip="Clear the damage list and start fresh.">
                        <Grid Width="18" Height="16">
                            <Path Data="M4,3 L14,13 M14,3 L4,13" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Button>
                    </StackPanel>
                    <!-- PVE/PVP mode switch, per the user: one row up from the filter dropdowns, a
                         segmented toggle (exactly one side active) rather than an independent
                         checkbox. PVP restricts the whole grid to damage against other players,
                         mobs/bosses excluded entirely, and overrides the Mob/Boss filter rather than
                         combining with it - see OnPvpModeToggleClicked/RefreshRows. Right-aligned
                         (Grid.Column="2"), per the user. -->
                    <!-- Profile (character window), Twitch Drops and announcements: in the top row, left of the PVE/PVP switch. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CharacterNavButton" Style="{StaticResource NavButton}" ToolTip="Open the character window (Aion 2): gear, skills, Daevanion" Click="OnShowCharacterView">
                            <Grid Width="16" Height="16">
                                <Ellipse Width="5.6" Height="5.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1.2,0,0"/>
                                <Path Data="M4,14.5 L4,11.8 Q4,8.6 8,8.6 Q12,8.6 12,11.8 L12,14.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button>
                        <Button x:Name="TwitchDropsButton" Style="{StaticResource ToolbarIconButton}" Click="OnTwitchDropsClicked" Padding="5" Margin="4"
                                Visibility="Collapsed" ToolTip="{local:Loc Main.TwitchDrops.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="F1 M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"
                                      Fill="#A970FF" Width="15" Height="15" Stretch="Uniform"/>
                                <Border x:Name="TwitchDropsNewBadge" Visibility="Collapsed" Margin="5,0,0,0" Padding="6,1" CornerRadius="8"
                                        Background="#FFD24A" VerticalAlignment="Center">
                                    <TextBlock Text="{local:Loc Main.TwitchDrops.New}" FontSize="11" FontWeight="ExtraBold" Foreground="#1A1200"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AnnouncementsButton" Style="{StaticResource ToolbarIconButton}" Click="OnAnnouncementsClicked" Padding="5" Margin="4"
                                ToolTip="{local:Loc Main.Announcements.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,9 L3,15 L7,15 L14,20 L14,4 L7,9 Z M17,8 C18.5,9.5 18.5,14.5 17,16 M19.5,5.5 C22.5,8.5 22.5,15.5 19.5,18.5"
                                      Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="18" Height="15" Stretch="Uniform"/>
                                <Border x:Name="AnnouncementsNewBadge" Visibility="Collapsed" Margin="5,0,0,0" Padding="6,1" CornerRadius="8"
                                        Background="#FFD24A" VerticalAlignment="Center">
                                    <TextBlock Text="{local:Loc Main.Announcements.New}" FontSize="11" FontWeight="ExtraBold" Foreground="#1A1200"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                </Grid>

                <!-- View nav (Damage/Loot/Character Profile) plus Upload, in one row above the
                     filter dropdowns - per the user: used to be a full-height rail down the left
                     edge of the grid, eating horizontal space the grid itself could use, and Upload
                     sat up in the icon toolbar instead. NavButton shrunk from 40x40 to 30x30 for
                     this row (still bigger than the plain toolbar icon buttons above, per the same
                     request, just no longer tall enough to justify its own column). Grid with an
                     Auto/*/Auto column split, not a single StackPanel, so Upload sits flush right
                     without needing to know how wide the nav icons end up. -->
                <Grid DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Icons instead of text per the reference layout - NavButton's Background is
                         already TemplateBinding'd (see its Button base style above), so the active/
                         inactive swap in OnShowDamageView/OnShowLootView is a plain property set, no
                         new style needed. Each Path's Stroke binds to its own Button's Foreground
                         (which that same code toggles alongside Background) rather than a fixed color,
                         since Path.Stroke isn't inherited the way TextBlock.Foreground is. Minus Skill
                         Rotation and Instance Scores from MyAion's own icon set - per the user,
                         removed rather than kept as disabled placeholders (neither has a packet
                         source to ever back it: skill-cast order, resp. cross-encounter instance
                         aggregation + boss detection). Character Profile stays as a disabled
                         placeholder since it wasn't asked to go too. See README's UI-placeholders
                         section. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- The five display modes as buttons (they were the "Mode" menu): damage, heal, damage taken, All in One,
                             All in One +. The icon pictures and the active look are set in ApplyModeButtons (assets/modes). -->
                        <Button x:Name="ModeDamageButton" Style="{StaticResource NavButton}" Padding="2" Tag="Damage" ToolTip="{local:Loc Main.ModeDamage}" Click="OnModeButtonClicked">
                            <Image x:Name="ModeDamageImage" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Button x:Name="ModeHealButton" Style="{StaticResource NavButton}" Padding="2" Tag="Heal" ToolTip="{local:Loc Main.ModeHeal}" Click="OnModeButtonClicked">
                            <Image x:Name="ModeHealImage" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Button x:Name="ModeTakenButton" Style="{StaticResource NavButton}" Padding="2" Tag="Taken" ToolTip="{local:Loc Main.ModeTaken}" Click="OnModeButtonClicked">
                            <Image x:Name="ModeTakenImage" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Button x:Name="ModeAllButton" Style="{StaticResource NavButton}" Padding="2" Tag="All" ToolTip="{local:Loc Main.ModeAll}" Click="OnModeButtonClicked">
                            <Image x:Name="ModeAllImage" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Button x:Name="ModeAllPlusButton" Style="{StaticResource NavButton}" Padding="2" Tag="AllCompact" ToolTip="{local:Loc Main.ModeAllCompact}" Click="OnModeButtonClicked">
                            <Image x:Name="ModeAllPlusImage" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <!-- Rebuilt per the user (the old single lopsided arc from (1,15) to
                             (15,12.5) via one control point at (8,8) read as pinched/asymmetric,
                             not like shoulders) - now a centered head circle plus a symmetric
                             rounded-top body outline (open at the bottom, the same "person" shape
                             family as Feather/Bootstrap's own user icon), both halves mirroring
                             each other around x=8. -->
                        
                    </StackPanel>
                    <!-- Hide UI (eye icon) and Upload, both moved here from the icon toolbar above,
                         per the user - Hide UI now sits immediately left of Upload rather than up
                         in that row. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Icon instead of text, per the user's request - a simple vector eye glyph
                             (no bitmap asset exists for this, unlike the class icons, so drawn inline)
                             rather than the word "Hide UI". ToolTip is kept, per the same request, as
                             the only remaining explanation of what it does - trimmed to one line after
                             terminal_windows flagged the original ~500-char version as unreadable hover
                             text over a 32px icon. Full behavior, for reference: forces Always-on-Top
                             and hides the taskbar entry while active (restoring both on exit, since a
                             click-through overlay sitting behind the game or cluttering the taskbar
                             would defeat the point); the button itself becomes unreachable once the
                             window is click-through, which is why Ctrl+Alt+H exists to bring it back. -->
                        <!-- Twitch Drops: shown only while a campaign runs (RefreshTwitchDropsBadge), left of the announcements icon; "New" while the newest
                             campaign is one not seen at the last click. Opens the page on aiondps.com. -->
                        
                        <!-- AION 2 announcements: only a link to the page on aiondps.com; "New" shows beside the icon while there is
                             an announcement newer than the one seen at the last click (OnAnnouncementsClicked / RefreshAnnouncementsBadge). -->
                        
                        <Button x:Name="HideUiButton" Style="{StaticResource ToolbarIconButton}" Click="OnHideUiClicked" Padding="5" Margin="4"
                                ToolTip="Overlay mode: transparent, click-through, shows a small DPS chip per player. Ctrl+Alt+H brings the UI back.">
                            <Path Data="M1,12 C1,12 4.5,5 12,5 19.5,5 23,12 23,12 23,12 19.5,19 12,19 4.5,19 1,12 1,12 Z
                                        M12,15 A3,3 0 1 0 12,9 3,3 0 1 0 12,15 Z"
                                  Fill="{DynamicResource Brush.Text}" Width="18" Height="14" Stretch="Uniform"/>
                        </Button>
                        <!-- Uploads exactly the boss the Mob/Boss filter is currently showing -
                             hidden in the Loot view and whenever there's nothing recorded yet, both
                             still handled the same way by RefreshUploadAvailability regardless of
                             where the button physically sits. -->
                        <Button x:Name="UploadBossButton" Style="{StaticResource ToolbarIconButton}" Click="OnUploadCurrentBossClicked" Padding="5"
                                Margin="4" Visibility="Collapsed"
                                ToolTip="Uploads this boss fight to aiondps.com.">
                            <Path Data="M9,2 L9,10 M4,7 L9,2 L14,7 M3,13 L15,13"
                                  Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="18" Height="15" Stretch="Uniform"/>
                        </Button>
                        <!-- The paths of this boss fight for the replay (the fight itself goes up with it): a play triangle in an almost closed circle with an arrowhead. -->
                        <Button x:Name="UploadReplayButton" Style="{StaticResource ToolbarIconButton}" Click="OnUploadReplayClicked" Padding="5"
                                Margin="4" Visibility="Collapsed"
                                ToolTip="{local:Loc Main.UploadReplay.Tooltip}">
                            <Canvas Width="20" Height="20">
                                <Path Data="M10,3 A7,7 0 1 0 15.6,5.6 M10,0.6 L10,5.4 L14.2,3 Z"
                                      Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M8,7 L13.2,10 L8,13 Z" Fill="{DynamicResource Brush.Text}"/>
                            </Canvas>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Filter row: three dropdowns, matching the myaion.eu reference exactly (class
                     list uses its internal names Bard/Gunner/Painter, not the "modern"
                     Songweaver/Gunslinger - Painter itself is a post-4.6 class per the user, kept
                     here only for parity with the reference, marked in its tooltip). ClassFilter
                     was decorative-only until classes started being detected for players besides
                     "You" (see MainWindow.ResolveClassName) - now real, per the user: an empty
                     grid when nobody of the picked class is present is correct, not a bug. The
                     Mob/Boss filter below was already real before that. -->
                <!-- Labels removed per the user ("Die Worte VOR den Dropdowns können weg") - each
                     dropdown's own ToolTip plus, for ClassFilter now, the visible class name inside
                     it, carries enough meaning without a preceding "Class:"/"Source:"/"Mob/Boss:"
                     text label. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{DynamicResource Brush.Window}">
                    <!-- Icon + class name, per the user ("das Dropdown darf die Namen enthalten") -
                         previously icon-only; ClassIconConverter/pack://siteoforigin remarks that
                         used to sit here now live on NewCharacterClassBox in SettingsWindow.xaml,
                         which needed the identical icon-visibility fix and still explains it. -->
                    <!-- AutomationProperties.Name on every entry below: found by terminal_windows
                         trying to drive this dropdown by name for testing - a ComboBoxItem whose
                         Content is a visual tree (icon + TextBlock, not a plain string) doesn't
                         automatically expose that TextBlock's text as its automation name, so
                         every entry but "All" (plain string Content) read back empty or as the
                         raw type name. Same gap would affect a screen reader, not just test
                         tooling - explicit Name fixes both with the same one-liner. -->
                    <ComboBox x:Name="ClassFilter" SelectedIndex="0" Margin="0" MinWidth="0" SelectionChanged="OnClassFilterChanged">
                        <ComboBoxItem Content="{local:Loc Main.FilterAllClasses}"/>
                        <ComboBoxItem Tag="Aethertech" AutomationProperties.Name="Aethertech"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Aethertech.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Aethertech" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Assassin" AutomationProperties.Name="Assassin"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Assassin.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Assassin" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Bard" AutomationProperties.Name="Bard"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Bard.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Bard" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Chanter" AutomationProperties.Name="Chanter"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Chanter.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Chanter" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Cleric" AutomationProperties.Name="Cleric"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Cleric.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Cleric" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Gladiator" AutomationProperties.Name="Gladiator"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Gladiator.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Gladiator" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Gunner" AutomationProperties.Name="Gunner"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Gunner.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Gunner" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <!-- Painter is a post-4.6 class, kept only for parity with the myaion.eu
                             reference - not expected to actually occur on a 4.6 server. -->
                        <ComboBoxItem Tag="Painter" AutomationProperties.Name="Painter"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Painter.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Painter" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Ranger" AutomationProperties.Name="Ranger"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Ranger.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Ranger" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Sorcerer" AutomationProperties.Name="Sorcerer"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Sorcerer.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Sorcerer" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Spiritmaster" AutomationProperties.Name="Spiritmaster"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Spiritmaster.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Spiritmaster" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Templar" AutomationProperties.Name="Templar"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Templar.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Templar" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                    </ComboBox>
                    <!-- Placeholder: a DISPLAY filter only, collection always keeps everyone's
                         damage regardless of this setting. Needs group/legion/race data we don't
                         decode yet. -->
                    <ComboBox x:Name="SourceFilter" SelectedIndex="0" Margin="8,0,0,0" MinWidth="0"
                              ToolTip="Not wired up yet (display filter only).">
                        <ComboBoxItem Content="{local:Loc Main.FilterAllGroups}"/>
                        <ComboBoxItem Content="{local:Loc Main.FilterSelf}"/>
                        <ComboBoxItem Content="{local:Loc Main.FilterGroup}"/>
                        <ComboBoxItem Content="{local:Loc Main.Scope.Corps}"/>
                        <ComboBoxItem Content="{local:Loc Main.FilterLegion}"/>
                        <ComboBoxItem Content="{local:Loc Main.FilterElyos}"/>
                        <ComboBoxItem Content="{local:Loc Main.FilterAsmodian}"/>
                    </ComboBox>
                    <!-- Lists targets actually seen this session. "All" sums each source's damage
                         across every target (the ambiguous wall-clock view - see DpsCalculator
                         remarks); picking one target switches DPS to true per-target iDPS. -->
                    <ComboBox x:Name="MobBossFilter" Style="{StaticResource SearchableComboBox}"
                              SelectedIndex="0" SelectionChanged="OnMobBossFilterChanged" Margin="8,0,0,0" MinWidth="0" MaxWidth="180"
                              ToolTip="Filter by target. 'All' sums damage across every target seen. Type in the dropdown to search.">
                        <ComboBoxItem Content="{local:Loc Main.FilterAllTargets}"/>
                    </ComboBox>
                </StackPanel>

                <!-- Bottom notice row: update available, upload results and the capture status; each
                     element is collapsed until there is something to say. -->
                <StackPanel DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}">
                    <StackPanel Orientation="Horizontal" Height="22">

                        <!-- Update notice. Deliberately a quiet line in the status row and NOT a
                             popup: the meter sits on top of a running game, and a modal dialog
                             appearing mid-boss because a background timer fired would steal focus
                             from the fight. It only becomes visible when there is something to say,
                             and clicking it is what starts anything. -->
                        <TextBlock x:Name="UpdateNotice" Visibility="Collapsed" VerticalAlignment="Center"
                                   Margin="8,0,8,0" Foreground="{DynamicResource Brush.Accent}" Cursor="Hand"
                                   MouseLeftButtonUp="OnUpdateNoticeClicked"
                                   TextDecorations="Underline"
                                   ToolTip="A newer version is available - click to download and install it."/>

                        <!-- Quiet result line for the two upload actions (Session menu + the Damage
                             view's Upload button) - same reasoning as UpdateNotice above: this window
                             sits on top of a running fight, so a result never pops a modal dialog. -->
                        <!-- Guard against wrong totals (Aion 2): the selected target's damage held
                             against the hit points the server says it lost - see UpdateHpCheck. -->
                        <TextBlock x:Name="HpCheckText" Visibility="Collapsed" VerticalAlignment="Center"
                                   Margin="8,0,8,0" Foreground="{DynamicResource Brush.TextMuted}"
                                   ToolTip="{local:Loc Main.HpCheck.Tooltip}"/>

                        <!-- A game patch moved the opcode of a kind of fight data: the numbers above are incomplete (see ProtocolHealth). -->
                        <TextBlock x:Name="ProtocolBreakText" Visibility="Collapsed" VerticalAlignment="Center"
                                   Margin="8,0,8,0" Foreground="{DynamicResource Brush.Warning}" FontWeight="Bold"
                                   ToolTip="{local:Loc Main.ProtocolBreak.Tooltip}"/>

        <TextBlock x:Name="UploadStatusText" Visibility="Collapsed" VerticalAlignment="Center"
                                   Margin="8,0,8,0" Foreground="{DynamicResource Brush.TextMuted}"/>

                        <!-- Shown while a past fight from the history is loaded instead of the live
                             session (see EnterHistoryMode); clicking it returns to live. -->
                        <TextBlock x:Name="HistoryBanner" Visibility="Collapsed" VerticalAlignment="Center"
                                   Margin="8,0,8,0" Foreground="{DynamicResource Brush.Warning}" FontWeight="Bold" Cursor="Hand"
                                   MouseLeftButtonUp="OnHistoryBannerClicked"
                                   ToolTip="A stored fight is shown. Click to return to the live session."/>
                    </StackPanel>
                </StackPanel>


                <!-- GridLinesVisibility="None", not "Horizontal" - per the user, the bright
                     Border-colored separator line between rows contrasted very differently
                     against RowAlt (dark) than against Panel (lighter), which read as the lighter
                     rows extending past their real edge ("heller Hintergrund wirkt höher"). The
                     alternating RowBackground/AlternatingRowBackground colors already separate one
                     player's row from the next without it. -->
                <local:QuietDataGrid x:Name="PlayersGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="OnPlayersGridDoubleClick"
                          Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}" RowBackground="{DynamicResource Brush.RowAlt}" AlternatingRowBackground="{DynamicResource Brush.Panel}"
                          BorderBrush="{DynamicResource Brush.Border}"
                          GridLinesVisibility="None" HeadersVisibility="None" CanUserAddRows="False" Grid.IsSharedSizeScope="True">
                    <!-- Enemy rows get a dark red ground. A trigger rather than a converter so it
                         overrides RowBackground AND AlternatingRowBackground above: those are set
                         on the DataGrid itself and would otherwise win on every second row, which
                         would make the marking look like it came and went at random. -->
                    <!-- Right-click menu per row. Faction is correctable by hand because the log
                         cannot always answer it: in an arena the opponent is frequently the SAME
                         faction, and fighting someone only ever proves hostility, never which
                         banner they fight under. -->
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Text}">
                            <MenuItem Header="Details anzeigen" Click="OnShowPlayerDetailsClicked"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.RowEnemy}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <!-- Found by terminal_windows measuring rendered pixels: clicking a row lit it
                         up #F0F0F0 - the default DataGridCell template pulls its selected-state
                         colors from SystemColors.Highlight*, which ignores the window's own
                         Background/Foreground entirely. Overriding those brush keys, scoped to
                         just this DataGrid rather than the whole window, recolors the built-in
                         selection visuals without touching anything else that might reference the
                         same system keys (e.g. a MenuItem's own highlight). -->
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource Color.Border}"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource Color.Text}"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource Color.Border}"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource Color.Text}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- Column widths trimmed slightly (Level 50->40) after terminal_windows
                             measured the grid at only 1px of clearance from the window edge - zero
                             margin for a different DPI scaling or a future column, now ~30px of
                             buffer instead. -->
                        <!-- Class no longer has its own column, per the user: the icon sits right
                             before the name in this single column instead (StackPanel, icon then
                             TextBlock) - one less column to fit, and class/name read as one unit
                             the way a character actually presents. Icon falls back to nothing (no
                             icon, no crash) for "?" or any class name without a matching
                             assets/classes/icons/*.png - see ClassIconConverter. -->
                        <!-- Name and Damage/DPS used to be two independently-resizable columns
                             (NameColumn/DpsColumn, widths persisted via MeterSettings) - merged into
                             one Width="*" column per the user's reference layout, so the ShareBar
                             below can span the row's full remaining width instead of being boxed
                             into the old 124px Damage column. That's the one real trade-off: the two
                             columns' independent drag-resize/persistence is gone (RestoreWindowGeometry/
                             SaveWindowGeometry no longer touch it), replaced by the column simply
                             always filling whatever the (now much wider, still itself persisted)
                             window leaves available. -->
                        <DataGridTemplateColumn x:Name="PlayerColumn" Width="*">
                            <!-- A literal UIElement, not a HeaderTemplate/DataTemplate - it is built
                                 once, not per row, so it lives in the window's own NameScope and
                                 DpsHeaderText below is a real code-behind field, the same as any
                                 other x:Name (see OnMobBossFilterChanged/RefreshRows, which used to
                                 write DpsColumn.Header and now write DpsHeaderText.Text instead). -->
                            <!-- Two real columns, not two overlaid TextBlocks kept apart only by
                                 alignment - per the user, "Name" and "Damage / DPS" visually
                                 overlapped/garbled into each other once the window was narrow
                                 enough that the left-aligned "Name" text ran into the right-aligned
                                 DPS label with nothing actually reserving space between them. -->
                            <DataGridTemplateColumn.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{local:Loc Main.ColumnName}"/>
                                    <TextBlock Grid.Column="1" x:Name="DpsHeaderText" Text="{local:Loc Main.ColumnDamageDps}"
                                               Margin="0,0,8,0"/>
                                </Grid>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- One fixed-column row (rank, class icon, name, damage taken, DPS, damage):
                                         the number columns share their width across all rows
                                         (Grid.IsSharedSizeScope on the grid), so every figure sits in the
                                         same column whatever its length, and a column that is empty
                                         everywhere (damage taken switched off) takes no room. The class
                                         colour bar fills the whole row height. Opt-in extras (relic AP,
                                         avoided attacks, PVP) get a second line only when there are any. -->
                                    <Grid MinHeight="32">
                                        <ProgressBar Style="{StaticResource RowFillBar}" Value="{Binding AbsorbedFillPercent, Mode=OneWay}"
                                                     Foreground="#993AA0FF"
                                                     Visibility="{Binding ShowShareBar, Converter={StaticResource BoolToVis}}"/>
                                        <ProgressBar Style="{StaticResource RowFillBar}" Value="{Binding FillPercent, Mode=OneWay}"
                                                     Foreground="{Binding ClassBrush}"
                                                     Visibility="{Binding ShowShareBar, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel VerticalAlignment="Center" Margin="8,3,8,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Taken"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Dps"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Damage"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- the faction emblem replaces the rank number (the number only shows while the faction is unknown) -->
                                                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Image Source="{Binding Faction, Converter={StaticResource RaceIconConverter}}" Width="15" Height="15" ToolTip="{Binding Faction}"/>
                                                    <TextBlock Text="{Binding RankDisplay}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Visibility="Collapsed">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Faction}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Image Grid.Column="1" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"
                                                       Height="24" Width="24" Margin="4,0,8,0" ToolTip="{Binding Faction}"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <local:AllLine FontSize="10.5" TextElement.Foreground="{DynamicResource Brush.Text}" Opacity="0.85"/>
                                                </StackPanel>
                                                <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0" ToolTip="Damage this player received in the shown window">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="TakenRed"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="TakenBlue"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TakenDisplay}" Style="{StaticResource AllTakenMuted}" FontSize="11" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AbsorbedDisplay}" Foreground="#3AA0FF" FontSize="11" Margin="8,0,0,0" HorizontalAlignment="Right"
                                                               ToolTip="Damage the group shield absorbed on this player"/>
                                                </Grid>
                                                <TextBlock Grid.Column="4" Text="{Binding RateOrHealDisplay}" Style="{StaticResource AllHealMuted}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                                <TextBlock Grid.Column="5" Text="{Binding DamageDisplay}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="50,0,0,0"
                                                        Visibility="{Binding HasExtraInfo, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ApDisplay}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                                <TextBlock Text="{Binding DefenseDisplay}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="6,0,0,0"
                                                           ToolTip="Avoided incoming attacks: D dodged, P parried, B blocked, R resisted (share of all incoming attacks)"/>
                                                <TextBlock Text="{Binding PvpDisplay}" Foreground="{DynamicResource Brush.Accent}" FontSize="11" Margin="6,0,0,0"
                                                           ToolTip="PVP: kills / deaths and the biggest hit landed on a player"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </local:QuietDataGrid>

            </DockPanel>

            <!-- Update-ready confirmation, in-app and app-themed. WindowStyle="None" above means
                 this window draws its own chrome everywhere else; a native MessageBox here would
                 pop up with the OS's own title bar and buttons, clashing with that (per the user).
                 A dimmed backdrop plus a themed card, both inside NormalContent, keeps it looking
                 like part of the app and keeps it out of the way in Hide-UI overlay mode (which
                 collapses NormalContent entirely, see OnHideUiClicked). -->
            <Border x:Name="UpdateRestartOverlay" Visibility="Collapsed" Background="#AA000000">
                <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="4" Padding="20" MaxWidth="380"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="UpdateRestartTitle" Text="{local:Loc Main.UpdateReady.Title}" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="UpdateRestartText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="UpdateRestartLaterButton" Content="{local:Loc Main.UpdateReady.Later}" Click="OnUpdateRestartLaterClicked" Margin="0,0,8,0" Padding="12,4"/>
                            <Button x:Name="UpdateRestartNowButton" Content="{local:Loc Main.UpdateReady.RestartNow}" Click="OnUpdateRestartNowClicked" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            </Grid>
        </Border>

        <!-- ================= Hide-UI overlay mode ================= -->
        <!-- Collapsed by default. Everything behind the window shows through (Window.Background
             is Transparent and NormalContent is hidden while this is visible); only a small dark
             chip per player stays visible. See OnHideUiClicked / NativeOverlay.cs for the
             click-through + hotkey handling that makes this safe to use over the actual game
             window.
             Per the user ("im Transparenten Modus identisch anzeigen, nur ohne UI Rahmen"): each
             chip now mirrors PlayersGrid's own two columns - faction + class icon, name, then
             Damage/DPS on one line with the RelicAp line underneath - instead of the old single
             "Name: Damage dmg (DPS)" text line, so switching modes doesn't also change what
             information is visible. It's the same content minus the window chrome (title bar,
             menu, toolbar, column headers, borders), not a different view. -->
        <!-- Compact Hide-UI panel (Settings: Hide UI look = Compact panel), the alternative to the
             chips below: the fought target, then one dense line per player - DPS, share, total -
             over a bar scaled to the leader. Unlike the chips it takes clicks (drag the header, the
             corner grip scales it, a line opens the player's skills); the window is transparent
             around it. Filled by UpdateCompactOverlay. -->
        <Border x:Name="CompactOverlayPanel" Visibility="Collapsed" Width="390" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource Brush.OverlayBg}" CornerRadius="6" Padding="6,5">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="CompactOverlayScale" ScaleX="1" ScaleY="1"/>
            </Border.LayoutTransform>
            <Border.Resources>
                <ControlTemplate x:Key="FlatBar" TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                    </Grid>
                </ControlTemplate>
                <ControlTemplate x:Key="ClassBar" TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" Opacity="0.45" CornerRadius="3"/>
                    </Grid>
                </ControlTemplate>
            </Border.Resources>
            <StackPanel>
                <!-- Header: state dot, fight, timer; then the controls a player reaches for in a fight.
                     Glyphs from Windows' own icon font (Segoe Fluent Icons / MDL2 Assets). Dragging the
                     free part of the header moves the panel. -->
                <DockPanel Margin="2,0,0,4" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnCompactOverlayDrag">
                    <DockPanel.Resources>
                        <Style x:Key="OverlayIconButton" TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="3"/>
                            <Setter Property="Padding" Value="3,2"/>
                            <Setter Property="Margin" Value="1,0,0,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="OverlayIconGlyph" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DockPanel.Resources>
                    <Border DockPanel.Dock="Right" Style="{StaticResource OverlayIconButton}" MouseLeftButtonDown="OnOverlayCloseClicked" ToolTip="{local:Loc Main.Overlay.Close}">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource OverlayIconGlyph}"/>
                    </Border>
                    <Border DockPanel.Dock="Right" Style="{StaticResource OverlayIconButton}" MouseLeftButtonDown="OnOverlayMinimizeClicked" ToolTip="{local:Loc Main.Overlay.Minimize}">
                        <TextBlock Text="&#xE921;" Style="{StaticResource OverlayIconGlyph}"/>
                    </Border>
                    <Border DockPanel.Dock="Right" Style="{StaticResource OverlayIconButton}" MouseLeftButtonDown="OnOverlayResetClicked" ToolTip="{local:Loc Main.Overlay.Reset}">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource OverlayIconGlyph}"/>
                    </Border>
                    <Border DockPanel.Dock="Right" Style="{StaticResource OverlayIconButton}" MouseLeftButtonDown="OnOverlayCopyClicked" ToolTip="{local:Loc Main.Overlay.Copy}">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource OverlayIconGlyph}"/>
                    </Border>
                    <Border DockPanel.Dock="Right" Style="{StaticResource OverlayIconButton}" MouseLeftButtonDown="OnOverlaySettingsClicked" ToolTip="{local:Loc Main.Overlay.Settings}">
                        <TextBlock Text="&#xE713;" Style="{StaticResource OverlayIconGlyph}"/>
                    </Border>
                    <!-- Damage / healing / damage taken switch (also Settings' shortcut and the Mode menu). -->
                    <Border x:Name="OverlayModeSwitch" DockPanel.Dock="Right" Background="#33FFFFFF" CornerRadius="3" Padding="5,0" Margin="6,0,3,0"
                            Cursor="Hand" MouseLeftButtonDown="OnOverlayModeClicked">
                        <TextBlock x:Name="OverlayModeText" Foreground="{DynamicResource Brush.OverlayText}" FontSize="10"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                    <!-- An update is on its way / waiting, or this version may no longer upload (see SetUpdateStatus); a click does what the status row's notice does. -->
                    <Border x:Name="CompactUpdateBadge" DockPanel.Dock="Right" Visibility="Collapsed" CornerRadius="3" Padding="5,0" Margin="6,0,0,0"
                            Cursor="Hand" MouseLeftButtonDown="OnUpdateNoticeClicked">
                        <TextBlock x:Name="CompactUpdateBadgeText" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FF101820"/>
                    </Border>
                    <!-- Green: capturing; orange: paused; grey: waiting for the game. -->
                    <Ellipse x:Name="OverlayStateDot" Width="7" Height="7" Fill="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="OverlayTimeText" DockPanel.Dock="Right" Foreground="{DynamicResource Brush.Accent}"
                               FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock x:Name="OverlayTargetText" DockPanel.Dock="Left" MaxWidth="100" Foreground="{DynamicResource Brush.OverlayText}" FontWeight="Bold"
                               FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <!-- What the rows show: everybody / my group / my corps (two parties together). -->
                    <StackPanel x:Name="OverlayScopeSwitch" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border x:Name="OverlayScopeAll" Tag="All" Padding="5,1" CornerRadius="3,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnOverlayScopeClicked">
                            <TextBlock FontSize="9" FontWeight="Bold" Text="{local:Loc Main.Scope.All}"/>
                        </Border>
                        <Border x:Name="OverlayScopeGroup" Tag="Group" Padding="5,1" Margin="1,0,0,0" Cursor="Hand" MouseLeftButtonDown="OnOverlayScopeClicked">
                            <TextBlock FontSize="9" FontWeight="Bold" Text="{local:Loc Main.Scope.Group}"/>
                        </Border>
                        <Border x:Name="OverlayScopeCorps" Tag="Corps" Padding="5,1" Margin="1,0,0,0" CornerRadius="0,3,3,0" Cursor="Hand" MouseLeftButtonDown="OnOverlayScopeClicked">
                            <TextBlock FontSize="9" FontWeight="Bold" Text="{local:Loc Main.Scope.Corps}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <!-- The fought boss's health (Settings: show the boss's health), with the HP check's verdict. -->
                <Grid x:Name="OverlayHpBlock" Height="16" Margin="0,0,0,5" Visibility="Collapsed">
                    <ProgressBar x:Name="OverlayHpBar" Template="{StaticResource FlatBar}" Minimum="0" Maximum="100"
                                 Background="#33FFFFFF" Foreground="#CCB03A2E"/>
                    <TextBlock x:Name="OverlayHpCheckText" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.OverlayText}"/>
                    <TextBlock x:Name="OverlayHpText" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                               FontSize="10" Foreground="{DynamicResource Brush.OverlayText}"/>
                </Grid>
                <!-- Column legend: what the three numbers of each line are. -->
                <Grid Margin="4,0,4,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{local:Loc Main.Overlay.ColPlayer}" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="9"/>
                    <TextBlock x:Name="OverlayRateHeader" Grid.Column="2" Text="DPS" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="9" Margin="6,0,0,0"/>
                    <TextBlock x:Name="OverlayShareHeader" Grid.Column="3" Text="%" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="9" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="OverlayTotalHeader" Grid.Column="4" Text="{local:Loc Main.Overlay.ColTotal}" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="9" HorizontalAlignment="Right"/>
                </Grid>
                <local:QuietItemsControl x:Name="CompactOverlayRows" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="20" Margin="0,1" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonUp="OnCompactOverlayRowClicked">
                                <ProgressBar Template="{StaticResource ClassBar}" Minimum="0" Maximum="100"
                                             Value="{Binding FillPercent, Mode=OneWay}" Background="#26FFFFFF">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Foreground" Value="{Binding ClassBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OverlayEnemy}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"
                                           Height="20" Width="20" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NameDisplay}" Foreground="{DynamicResource Brush.OverlayText}" FontWeight="Bold"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <local:AllLine FontSize="9.5" TextElement.Foreground="{DynamicResource Brush.OverlayText}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding RateOrDamageCompact}" Foreground="{DynamicResource Brush.OverlayText}" FontWeight="Bold"
                                               FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ShareOrHealCompact}" Style="{StaticResource AllHealSubtle}"
                                               FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding TotalOrTakenCompact}" Style="{StaticResource AllTakenSubtle}"
                                               FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </local:QuietItemsControl>
                <!-- Corner grip: drag to scale the whole panel, text included (OnCompactOverlayResize). -->
                <Thumb HorizontalAlignment="Right" Width="12" Height="12" Cursor="SizeNWSE" Margin="0,4,0,0"
                       DragDelta="OnCompactOverlayResize" DragCompleted="OnCompactOverlayResized">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M11,1 L1,11 M11,5 L5,11 M11,9 L9,11" Stroke="{DynamicResource Brush.TextSubtle}" StrokeThickness="1"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </StackPanel>
        </Border>

        <local:QuietItemsControl x:Name="OverlayContent" Visibility="Collapsed" Background="Transparent"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,1" Padding="8,3" MinHeight="32">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.OverlayBg}"/>
                                <Style.Triggers>
                                    <!-- Same rule as PlayersGrid.RowStyle, so an enemy row reads
                                         the same way in both modes. -->
                                    <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.OverlayEnemy}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                        <ProgressBar Style="{StaticResource RowFillBar}" Value="{Binding AbsorbedFillPercent, Mode=OneWay}"
                                     Foreground="#993AA0FF"
                                     Visibility="{Binding ShowShareBar, Converter={StaticResource BoolToVis}}"/>
                        <ProgressBar Style="{StaticResource RowFillBar}" Value="{Binding FillPercent, Mode=OneWay}"
                                     Foreground="{Binding ClassBrush}"
                                     Visibility="{Binding ShowShareBar, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel VerticalAlignment="Center">
                            <!-- Same fixed columns as the window's row: rank, class icon, name, then DPS and
                                 damage in columns shared by all chips. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChipTaken"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChipDps"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChipDamage"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{Binding Faction, Converter={StaticResource RaceIconConverter}}" Width="14" Height="14"/>
                                    <TextBlock Text="{Binding RankDisplay}" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Faction}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Image Grid.Column="1" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"
                                       Height="24" Width="24" Margin="4,0,8,0"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.OverlayText}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <local:AllLine FontSize="10" TextElement.Foreground="{DynamicResource Brush.OverlayText}"/>
                                </StackPanel>
                                <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ChipTakenRed"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ChipTakenBlue"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TakenDisplay}" Style="{StaticResource AllTakenSubtle}" FontSize="11" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AbsorbedDisplay}" Foreground="#3AA0FF" FontSize="11" Margin="8,0,0,0" HorizontalAlignment="Right"
                                                               ToolTip="Damage the group shield absorbed on this player"/>
                                                </Grid>
                                <TextBlock Grid.Column="4" Text="{Binding RateOrHealDisplay}" Style="{StaticResource AllHealSubtle}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="5" Text="{Binding Damage, StringFormat=N0}" Foreground="{DynamicResource Brush.OverlayText}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="40,0,0,0"
                                        Visibility="{Binding HasExtraInfo, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ApDisplay}" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="10"/>
                                <TextBlock Text="{Binding DefenseDisplay}" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="10" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding PvpDisplay}" Foreground="{DynamicResource Brush.Accent}" FontSize="10" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </local:QuietItemsControl>

        <!-- The same hint for the player chips: the window is click-through there, so it only shows. -->
        <Border x:Name="OverlayUpdateBadge" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                CornerRadius="3" Padding="8,3" Margin="0,0,4,0">
            <TextBlock x:Name="OverlayUpdateBadgeText" FontSize="12" FontWeight="Bold" Foreground="#FF101820"/>
        </Border>
    </Grid>
</Window>
