                                             HorizontalContentAlignment="Right" MaxLength="3"
                                             Background="{DynamicResource Brush.Control}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}"
                                             IsEnabled="{Binding IsChecked, ElementName=AutoResetBox}" PreviewTextInput="OnDigitsOnly"/>
                                    <TextBlock Grid.Column="2" Text="{local:Loc Settings.AutoReset.Seconds}" VerticalAlignment="Center"/>
                                </Grid>
                                <CheckBox x:Name="RecordFightHistoryBox" Content="{local:Loc Settings.RecordFightHistory}"/>
                            </StackPanel>
                        </Border>
