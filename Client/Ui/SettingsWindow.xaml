                                        </Grid>
                                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,4"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PetRegionRows"/></ScrollViewer>
                                    </DockPanel>
                                </Grid>
                                <Grid x:Name="PetRarePanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="PetRareMaxText" TextWrapping="Wrap" FontSize="11" MinHeight="44" Foreground="{DynamicResource Brush.TextSubtle}"/>
                                            <Slider x:Name="PetRareMaxSlider" Style="{StaticResource ThemedSlider}" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    SmallChange="1" LargeChange="5" Margin="0,2" ValueChanged="OnPetRareSliderChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="PetRareInstanceText" TextWrapping="Wrap" FontSize="11" MinHeight="44" Foreground="{DynamicResource Brush.TextSubtle}"/>
                                            <Slider x:Name="PetRareInstanceSlider" Style="{StaticResource ThemedSlider}" Minimum="1" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    SmallChange="1" LargeChange="10" Margin="0,2" ValueChanged="OnPetRareSliderChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" Height="372">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="PetRareLeftColumn" Width="185" MinWidth="120"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*" MinWidth="190"/>
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PetRareTree" Margin="0,0,6,0"/></ScrollViewer>
                                        <GridSplitter Grid.Column="1" Style="{StaticResource PetSplitter}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ToolTip="{local:Loc Settings.PetRegion.Splitter}"/>
                                        <DockPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock DockPanel.Dock="Bottom" x:Name="PetRareHint" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextSubtle}"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="PetRareInfo" TextWrapping="Wrap" Height="64" Margin="0,0,0,6" Foreground="{DynamicResource Brush.Text}"/>
                                            <ContentControl x:Name="PetRareView"/>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NavGather, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource CardHint}" Text="{local:Loc Settings.Gather.Hint}" Margin="2,0,0,10"/>
                        <TextBlock x:Name="GatherFactionNote" Style="{StaticResource CardHint}" Margin="2,0,0,10" Visibility="Collapsed"/>
                        <StackPanel x:Name="GatherCards"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NavBoss, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="ShowBossOverlayBox" Content="{local:Loc Settings.Boss.Overlay}"/>
                                <CheckBox x:Name="BossOverlayLockedBox" Content="{local:Loc Settings.PetFarm.Locked}" Margin="0,4,0,0"/>
                                <CheckBox x:Name="BossNotifyBox" Content="{local:Loc Settings.Boss.Notify}" Checked="OnBossNotifyChanged" Unchecked="OnBossNotifyChanged"/>
                                <TextBlock Style="{StaticResource CardHint}" Text="{local:Loc Settings.Boss.Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="BossGroups"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NavUpdates, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:Loc Settings.Updates}"/>
                                <CheckBox x:Name="CheckForUpdatesBox" Content="{local:Loc Settings.CheckForUpdates}"
                                          ToolTip="Asks GitHub whether a newer version exists and sends nothing but the request itself. 'Check for updates' in the App menu still works when you ask for it."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
    </Border>
</Window>
