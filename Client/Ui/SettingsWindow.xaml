<Window x:Class="AionDPS.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionDPS.Ui"
        Title="{local:Loc Settings.WindowTitle}" Height="600" Width="440"
        Background="{DynamicResource Brush.Window}" WindowStartupLocation="CenterOwner"
        FontSize="{DynamicResource FontSize.Base}">
    <Window.Resources>
        <local:ClassIconConverter x:Key="ClassIconConverter"/>
        <local:RaceIconConverter x:Key="RaceIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Einstellungen A ("Seitenleiste", vom User gebilligter Prototyp): one row-style shared
             by the 5 sidebar RadioButtons below. Colors hard-coded navy/orange like the App-Menü
             flyout in MainWindow.xaml - same user decision ("Orange fest verdrahten"), same
             reasoning (no current theme has an orange accent). Foreground here becomes each
             RadioButton's own Foreground (muted by default, accent when checked - see the
             Trigger below); the icon Paths inside bind to it explicitly via
             RelativeSource/AncestorType since Path.Stroke isn't an inherited property the way
             TextBlock.Foreground is. -->
        <Style x:Key="SettingsNavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9db3c2"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1a2b38"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26405a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#ffba42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Same dark CheckBox fix as MainWindow - a Foreground setter never reaches the box
             itself, only its default (previously stock white) template does. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="14" Height="14" Background="{DynamicResource Brush.Panel}"
                                    BorderBrush="{DynamicResource Brush.CheckBorder}" BorderThickness="1" Margin="0,0,6,0">
                                <Path x:Name="Check" Data="M 2,7 L 6,11 L 12,3" Stroke="{DynamicResource Brush.Text}"
                                      StrokeThickness="1.6" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.CheckBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Per the user: the border around each section was too heavy (the OS's own themed
             GroupBox chrome - there's no BorderThickness setter that touches it, same lesson as
             every other control this session; only a full template replacement does). Thin,
             flat 1px border instead, header sitting above it rather than notched into the line. -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="2,0,0,3"
                                              TextElement.FontWeight="SemiBold"/>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
                                <ContentPresenter Margin="6"/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}"/>
        </Style>
        <!-- Same dark ScrollBar fix as MainWindow - this window's own ScrollViewer can show one
             once the settings list grows past the window height. -->
        <Style x:Key="DarkScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource Brush.ScrollThumb}" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource Brush.Window}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumb}" Margin="2"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Same dark ComboBox fix as MainWindow (see its Window.Resources comment for why a
             Background/Foreground setter alone doesn't do it) - ThemeBox/FontSizeBox were
             rendering with WPF's default light-theme chrome and popup otherwise. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource Brush.TextSubtle}" Margin="0,0,8,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,3,20,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <!-- Learned from the DataGrid selection fix: a plain Background/BorderBrush setter is
             enough for ListBox's own chrome, but the selected-ITEM highlight is driven by
             SystemColors.Highlight* inside the default template regardless - overridden the same
             way, scoped to just this list (see the CharactersList.Resources below). -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>
        <!-- Same dark ToolTip fix as MainWindow - the class-name tooltips on the icon-only
             ComboBoxItems below would otherwise show a bright white box. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{local:Loc Settings.Save}" Click="OnSaveClicked"/>
            <Button Content="{local:Loc Settings.Cancel}" Click="OnCancelClicked"/>
        </StackPanel>

        <!-- Einstellungen A ("Seitenleiste"): the ScrollViewer>StackPanel>5×GroupBox column this
             replaced is still exactly how MeterSettings.Load/Save and every OnXxx handler in
             SettingsWindow.xaml.cs expect to find these controls - only the SURROUNDING chrome
             changed (sidebar nav instead of one long scroll), every x:Name below is unchanged and
             in the same relative order. Categories are the same 5 as before (Aion-Installation /
             Charaktere / Ziele-Targets / Benutzeroberfläche / Updates) - NOT the 6-category split
             ("Allgemein"/"Anzeige") the HTML prototype explored, since that would restructure the
             settings themselves, not just their navigation (see the plan this was built from).
             GroupBox headers are gone: the sidebar names the category now, a second label would
             just repeat it. Colors: same "Orange fest verdrahten" decision as the App-Menü flyout
             - only this new chrome (sidebar background/active state/icons) is hard-coded
             navy/orange; the reused inner controls (ComboBox/CheckBox/TextBox above) keep their
             existing {DynamicResource Brush.*} bindings untouched. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#11202b" BorderBrush="#294557" BorderThickness="0,0,1,0">
                <StackPanel Margin="6">
                    <RadioButton x:Name="NavInstall" GroupName="SettingsNav" IsChecked="True" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,3 L12,3 L12,9 L2,9 Z M5,12 L9,12 M7,9 L7,12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.3" Width="14" Height="12" Margin="0,0,7,0"/>
                            <TextBlock Text="{local:Loc Settings.AionInstallation}" TextWrapping="Wrap" Width="84" FontSize="11.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavChars" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,7,0">
                                <Ellipse Width="6" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                         StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                <Path Data="M1,13 L1,11 Q7,7 13,11 L13,13 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                            </Grid>
                            <TextBlock Text="{local:Loc Settings.Nav.Characters}" TextWrapping="Wrap" Width="84" FontSize="11.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTargets" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,7,0">
                                <Ellipse Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
                                <Path Data="M7,0 L7,4 M7,10 L7,14 M0,7 L4,7 M10,7 L14,7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                            </Grid>
                            <TextBlock Text="{local:Loc Settings.Nav.Targets}" TextWrapping="Wrap" Width="84" FontSize="11.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavUi" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,7,0">
                                <Path Data="M1,4 L13,4 M1,10 L13,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,2,0,0"/>
                                <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,2"/>
                            </Grid>
                            <TextBlock Text="{local:Loc Settings.Nav.Interface}" TextWrapping="Wrap" Width="84" FontSize="11.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavUpdates" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,6 L6,2 L6,5 L11,5 M11,6 L7,10 L7,7 L2,7"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.3" Width="14" Height="10" Margin="0,0,7,0"/>
                            <TextBlock Text="{local:Loc Settings.Updates}" TextWrapping="Wrap" Width="84" FontSize="11.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <StackPanel Visibility="{Binding IsChecked, ElementName=NavInstall, Converter={StaticResource BoolToVis}}">
                        <!-- Server picked FIRST, folder second - per the user, this section's
                             whole point was not visible before: each server remembers its OWN
                             Chat.log folder (MeterSettings.ServerInstallFolders), so switching the
                             server here is what actually switches the folder below, not something
                             set independently of it. -->
                        <!-- Which game this install is for (MeterSettings.Game) - decides the
                             combat source (Chat.log tailer vs. Aion 2 packet capture), the class
                             roster and which server catalog the pickers below offer. Same
                             auto-vs-manual pattern as AutoDetectActiveCharacterBox further down:
                             checked (the default, MeterSettings.GameDetectionMode) keeps this in
                             sync with whichever client is actually running and disables the picker
                             below since it would just be overwritten; unchecked freezes it at
                             whatever's picked there. -->
                        <CheckBox x:Name="AutoDetectGameBox" Content="{local:Loc Settings.AutoDetectGame}"
                                  Margin="4,2,4,4" Checked="OnAutoDetectGameChanged" Unchecked="OnAutoDetectGameChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <TextBlock Text="{local:Loc Settings.Game}" VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <ComboBox x:Name="GameBox" Width="220" SelectionChanged="OnGameSelected">
                                <ComboBoxItem Content="Aion" Tag="aion"/>
                                <ComboBoxItem Content="Aion 2" Tag="aion2"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="GameDetectionStatus" TextWrapping="Wrap"
                                   Margin="4,0,4,6" FontStyle="Italic" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock x:Name="Aion2Hint" Text="{local:Loc Settings.Aion2Hint}" TextWrapping="Wrap"
                                   Margin="4,0,4,6" Foreground="{DynamicResource Brush.WarningSoft}" Visibility="Collapsed"/>
                        <TextBlock Text="Each server below remembers its own Chat.log folder - pick a server, then set (or confirm) its folder."
                                   TextWrapping="Wrap" Margin="4,2" FontStyle="Italic" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <!-- Same curated catalog as the "Add character" section's own server
                                 picker below (populated in LoadServerCatalogAsync), not free text -
                                 per the user, different servers are different Aion installs with
                                 different Chat.log paths, so this pick is also the key into
                                 MeterSettings.ServerInstallFolders (see OnAionServerSelected):
                                 switching it recalls that server's own folder instead of leaving
                                 whatever folder happened to be selected before. -->
                            <ComboBox x:Name="AionInstallServerBox" Width="220"
                                      SelectionChanged="OnAionServerSelected"
                                      ToolTip="Which server this Aion install connects to - picking one loads its own saved folder below, if any."/>
                        </StackPanel>

                        <TextBlock Text="{local:Loc Settings.FolderHint}"
                                   TextWrapping="Wrap" Margin="4,8,4,2"/>
                        <!-- Stacked, not side-by-side, per the user: the sidebar layout leaves this
                             column narrower than the old single-column dialog did, and a fixed-width
                             TextBox plus a Button next to it no longer both fit - the Button was
                             pushed past the window edge and stayed there even after a manual resize,
                             since nothing here persists SettingsWindow's size across reopens. Stacking
                             needs no extra width at all, at any window size. -->
                        <TextBox x:Name="AionInstallFolderBox" IsReadOnly="True"
                                 Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" Margin="4,2"/>
                        <Button Content="{local:Loc Settings.SelectFolder}" Click="OnSelectAionFolderClicked"
                                HorizontalAlignment="Left" Margin="4,2"/>
                        <TextBlock x:Name="AionInstallFolderStatus" Margin="4,2" TextWrapping="Wrap" FontStyle="Italic"/>

                        <!-- Per the user: EuroAion runs on a completely different gear standard
                             than this server, so community-backend runs must never be mixed
                             between servers. Chat.log itself carries no server identity at all
                             (checked and confirmed), so this reads bin64\config.ini's own
                             [ServerAddr] IP:port instead (see Server/ServerIdentity.cs) - stable
                             and unique per private-server operator. Read-only: it's a detected
                             fact, not something to hand-edit into agreeing with a different
                             server's config file. -->
                        <TextBlock Text="Detected server (used to keep community-backend runs from mixing across servers):"
                                   TextWrapping="Wrap" Margin="4,8,4,2"/>
                        <TextBlock x:Name="ServerFingerprintText" Margin="4,2" FontStyle="Italic" Foreground="{DynamicResource Brush.TextMuted}"/>

                        <!-- Makes MeterSettings.ServerInstallFolders itself visible, not just its
                             effect - per the user, the binding existed in code (added previous
                             session) but nothing on screen ever showed it. One line per
                             remembered server, refreshed in RefreshServerFolderList (constructor,
                             LoadServerCatalogAsync, OnAionServerSelected and OnSelectAionFolderClicked
                             all call it so this never goes stale while the dialog is open). -->
                        <TextBlock Text="Remembered folders:" Margin="4,8,4,2" FontWeight="Bold"/>
                        <ItemsControl x:Name="ServerFolderMappingsList" Margin="4,0,4,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.TextMuted}" FontStyle="Italic" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ServerFolderMappingsEmptyText" Text="(none yet - pick a server above, set its folder, then Save)"
                                   Margin="4,0,4,4" FontStyle="Italic" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>

                <!-- Chat.log never reveals the local player's own name - verified against a real
                     session (see MeterSettings.Characters remarks): the active character is
                     always written as the literal "You", and even login notifications only ever
                     name OTHER people. There is no way to auto-detect this, so the user maintains
                     the list by hand - exactly what they asked for ("mehrere Namen, damit du
                     weisst welchen Namen du eintragen musst"). Class is stored alongside the name
                     so the Players grid can finally show something other than "?" for the local
                     player, which Chat.log can't supply either. -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=NavChars, Converter={StaticResource BoolToVis}}">
                        <ListBox x:Name="CharactersList" Height="90" SelectionMode="Single"
                                 SelectionChanged="OnCharacterSelected">
                            <ListBox.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource Color.Border}"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource Color.Text}"/>
                            </ListBox.Resources>
                            <!-- Icon before the character's name, per the user's request - the
                                 icon here identifies the CLASS, the text is the character's NAME.
                                 NewCharacterClassBox below shows icon + class name too (picking a
                                 class to register a new character needs the name legible, not just
                                 the icon - found by terminal_windows after the icon-visibility fix
                                 still left that dropdown unreadable for anyone who doesn't have all
                                 13 class icons memorized). MainWindow's read-only ClassFilter stays
                                 icon-only on purpose: filtering by your own class doesn't need the
                                 name spelled out the way picking one to register does. -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Faction, Converter={StaticResource RaceIconConverter}}"
                                               Height="20" Width="20" Margin="0,0,4,0" ToolTip="{Binding Faction}"/>
                                        <Image Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"
                                               Height="20" Width="20" Margin="0,0,6,0" ToolTip="{Binding ClassName}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <!-- Per the user: which server a character is on has to be
                                             visible in the list itself, not just inferred - blank
                                             for a character predating server tracking, same
                                             ApDisplay-style "empty string, not a placeholder" rule
                                             as everywhere else this app shows an unknown value
                                             (CharacterProfile.ServerLabel already includes the
                                             surrounding " (...)", so no StringFormat is needed here). -->
                                        <TextBlock Text="{Binding ServerLabel}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Three rows, per the user: name+class+faction all on one row (as it was
                             right after splitting off the Add/Remove buttons below) still added up
                             to well over 400px of fields+margins alone - wider than this dialog's
                             entire 440px window, let alone the ~280px actually left next to the
                             140px sidebar, so the row itself overflowed the same way the buttons
                             once did. Faction now gets its own row instead of shrinking every field
                             until the icon+text ComboBoxItems (e.g. "Asmodian") no longer fit. -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <!-- VerticalAlignment/VerticalContentAlignment="Center" needed here,
                                 found by the user: without them the box (and the text inside it)
                                 sits at the TOP of the row instead of centered against its taller
                                 siblings, since TextBox doesn't stretch/center itself against a
                                 taller row the way the ComboBoxes' own templates already do. -->
                            <TextBox x:Name="NewCharacterNameBox" Width="90" Margin="4,2"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}"/>
                            <ComboBox x:Name="NewCharacterClassBox" Width="150">
                                <!-- Items come from ClassCatalog.ClassesFor(game) - see RebuildClassBox. -->
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="NewCharacterFactionBox" Width="120" SelectedIndex="0" Margin="4,2">
                                <ComboBoxItem Tag="Elyos" AutomationProperties.Name="Elyos" ToolTip="Elyos"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/races/icons/Elyos.png" Height="20" Margin="0,0,6,0"/><TextBlock Text="Elyos" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                                <ComboBoxItem Tag="Asmodian" AutomationProperties.Name="Asmodian" ToolTip="Asmodian"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/races/icons/Asmodian.png" Height="20" Margin="0,0,6,0"/><TextBlock Text="Asmodian" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <!-- Per the user: which server a character is on is now a required, explicit
                             pick from the backend's curated list (GET /api/server-catalog), not
                             free text or a silent auto-stamp - own row, since Name/Class/Faction
                             above already fill the dialog's width. Populated asynchronously by
                             LoadServerCatalogAsync; empty (not broken) if the backend is briefly
                             unreachable when the dialog opens. -->
                        <StackPanel Orientation="Horizontal" Margin="4,4,0,0">
                            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="NewCharacterServerBox" Width="280" SelectionChanged="OnNewCharacterServerSelected"
                                      ToolTip="Which real server this character is on - required, since two different servers' characters/runs must never be confused with each other."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,4,0,0">
                            <Button Content="{local:Loc Settings.Add}" Click="OnAddCharacterClicked" Width="70" Margin="0,0,6,0"
                                    ToolTip="Registers the name above as a new character."/>
                            <Button Content="{local:Loc Settings.Update}" Click="OnUpdateCharacterClicked" Width="70" Margin="0,0,6,0"
                                    ToolTip="Applies the fields above to the character selected in the list - including renaming it."/>
                            <Button Content="{local:Loc Settings.Remove}" Click="OnRemoveCharacterClicked" Width="70"
                                    ToolTip="Deletes the character selected in the list."/>
                        </StackPanel>
                        <!-- Per the user: running two Aion clients at once with two registered
                             characters means skill-based auto-detection can get stuck on the wrong
                             one (both may share a class, or both keep generating "You used skill"
                             lines from their own client) with no way to tell it apart from here -
                             see MeterSettings.AutoDetectActiveCharacter remarks. Unchecking this
                             freezes ActiveCharacterName at whatever's picked below, changeable any
                             time by coming back here (per the user, "später möchte ich mich vllt.
                             umentscheiden"). -->
                        <CheckBox x:Name="AutoDetectActiveCharacterBox" Content="{local:Loc Settings.AutoDetectActiveCharacter}"
                                  Margin="4,8,4,0" Checked="OnAutoDetectActiveCharacterChanged" Unchecked="OnAutoDetectActiveCharacterChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{local:Loc Settings.ActiveCharacter}" VerticalAlignment="Center" Margin="4,0"/>
                            <ComboBox x:Name="ActiveCharacterBox" Width="150"/>
                        </StackPanel>
                    </StackPanel>

                <!-- "Target (NPC) Bar" and "Players List" (Display DPS / Display Level) removed
                     per the user: both were entirely inert (no code anywhere reads ShowDps,
                     ShowLevel, or the three Target-Bar flags - matching MyAion's Target Bar
                     concept, which was never wired to a data source here) and DPS/Level were
                     never actually optional in practice (DPS always shows; Level lost its column
                     entirely earlier this session). Backing properties removed from
                     MeterSettings too - see git history if this section is ever revived once a
                     real data source exists. This dialog still deliberately does NOT include
                     MyAion's Loot Table, Kinah tracking, Auto-upload, or Donation Goal sections
                     for the same reason: an inert checkbox that looks functional but does nothing
                     is worse than no checkbox at all. -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=NavTargets, Converter={StaticResource BoolToVis}}">
                        <CheckBox x:Name="ShowPlayersBox" Content="{local:Loc Settings.ShowPlayers}"/>
                        <CheckBox x:Name="ShowMinionNpcsBox" Content="{local:Loc Settings.ShowMinionNpcs}"/>
                        <CheckBox x:Name="ShowCommonNpcsBox" Content="{local:Loc Settings.ShowCommonNpcs}"/>
                        <CheckBox x:Name="ShowEliteNpcsBox" Content="{local:Loc Settings.ShowEliteNpcs}"/>
                        <CheckBox x:Name="ShowHeroicNpcsBox" Content="{local:Loc Settings.ShowHeroicNpcs}"/>
                        <CheckBox x:Name="ShowLegendaryNpcsBox" Content="{local:Loc Settings.ShowLegendaryNpcs}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsChecked, ElementName=NavUi, Converter={StaticResource BoolToVis}}">
                        <!-- Grid instead of 3 separate horizontal StackPanels, per the user: a
                             StackPanel's fixed-Width label doesn't clip its TextBlock, so a longer
                             translated label (e.g. "Schriftgröße") simply overflowed past its 80px
                             slot instead of wrapping, visually shifting where that row's ComboBox
                             looked like it started - a Grid's first column is a real boundary every
                             row shares, so all three ComboBoxes now line up regardless of label
                             length in any language. -->
                        <!-- Only one Theme for now, per the user: the App-Menü/Settings chrome is
                             hard-coded navy/orange (see AppMenuFlyoutStyle/SettingsNavItem remarks)
                             and doesn't follow Brush.Accent the way the rest of the window still
                             does - offering 5 more themes here would just look broken against that
                             new chrome until they're properly re-checked against it. -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Loc Settings.Theme}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeBox" HorizontalAlignment="Left" Width="150">
                                <ComboBoxItem Content="{local:Loc Settings.ThemeDark}" Tag="Dark"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Loc Settings.FontSize}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FontSizeBox" HorizontalAlignment="Left" Width="150">
                                <ComboBoxItem Content="{local:Loc Settings.SizeSmall}" Tag="Small"/>
                                <ComboBoxItem Content="{local:Loc Settings.SizeMedium}" Tag="Medium"/>
                                <ComboBoxItem Content="{local:Loc Settings.SizeLarge}" Tag="Large"/>
                            </ComboBox>
                            <!-- Items generated in code-behind (see SettingsWindow's constructor) from
                                 LocalizationManager.SupportedLanguages, rather than eight hardcoded
                                 ComboBoxItems here: one list, not two that could drift apart. Changes
                                 LocalizationManager.Instance.Language immediately on selection (see
                                 OnLanguageChanged), so every open window's {local:Loc ...} bindings
                                 repaint right away instead of only after Save. -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Loc Settings.Language}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LanguageBox" HorizontalAlignment="Left" Width="150" SelectionChanged="OnLanguageChanged"/>
                        </Grid>
                        <!-- Same value as the View menu's "Always on top" toggle: see
                             MeterSettings.AlwaysOnTopOnStartup's remarks for why this is one
                             setting reachable two ways, not two independent switches. -->
                        <CheckBox x:Name="AlwaysOnTopBox" Content="{local:Loc Settings.AlwaysOnTop}"/>
                        <!-- Per-row extras in the Damage view (see PlayerRow.SharePercent/DamageTaken). -->
                        <CheckBox x:Name="ShowShareBarsBox" Content="{local:Loc Settings.ShowShareBars}" Margin="0,4,0,0"/>
                        <CheckBox x:Name="ShowDamageTakenBox" Content="{local:Loc Settings.ShowDamageTaken}"/>
                        <CheckBox x:Name="ShowDefenseStatsBox" Content="{local:Loc Settings.ShowDefenseStats}"/>
                        <!-- Local only (History/FightStore, %AppData%) - nothing about it is uploaded. -->
                        <CheckBox x:Name="RecordFightHistoryBox" Content="{local:Loc Settings.RecordFightHistory}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- The meter's only outbound network call, so it gets a real switch rather than
                     being an invisible background behaviour. See MeterSettings.CheckForUpdates. -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=NavUpdates, Converter={StaticResource BoolToVis}}">
                    <CheckBox x:Name="CheckForUpdatesBox" Content="{local:Loc Settings.CheckForUpdates}"
                              ToolTip="The only thing this program ever sends anywhere. Turn it off and nothing leaves your machine; 'Check for updates' in the App menu still works when you ask for it."/>
                </StackPanel>

            </Grid>
        </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
