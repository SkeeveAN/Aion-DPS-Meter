                                             VerticalContentAlignment="Center" Background="{DynamicResource Brush.Control}"
                                             Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}"/>
                                    <Button Grid.Column="2" Tag="HotkeyUploadBossBox" Click="OnHotkeyClearClicked" Height="28" Width="28" Margin="6,2,0,2" Padding="0"
                                            Content="✕" ToolTip="{local:Loc Settings.Hotkey.Clear.Tip}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:Loc Settings.Hotkey.Mode}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                    <TextBox x:Name="HotkeyModeBox" Grid.Column="1" Height="28" Margin="0,2" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" GotKeyboardFocus="OnHotkeyBoxGotFocus" LostKeyboardFocus="OnHotkeyBoxLostFocus"
