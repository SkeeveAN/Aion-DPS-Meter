                                        <ComboBoxItem Content="45 %" Tag="0.45"/>
                                        <ComboBoxItem Content="60 %" Tag="0.6"/>
                                        <ComboBoxItem Content="80 %" Tag="0.8"/>
                                        <ComboBoxItem Content="100 %" Tag="1"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="AlwaysOnTopBox" Content="{local:Loc Settings.AlwaysOnTop}"/>
                                <CheckBox x:Name="ShowShareBarsBox" Content="{local:Loc Settings.ShowShareBars}"/>
                                <CheckBox x:Name="ShowBossHpBox" Content="{local:Loc Settings.ShowBossHp}"/>
                                <CheckBox x:Name="ShowDamageTakenBox" Content="{local:Loc Settings.ShowDamageTaken}"/>
                            </StackPanel>
