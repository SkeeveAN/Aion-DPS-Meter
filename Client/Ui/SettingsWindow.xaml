<Window x:Class="AionDPS.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionDPS.Ui"
        Title="{local:Loc Settings.WindowTitle}" Height="725" Width="641"
        Background="{DynamicResource Brush.Window}" WindowStartupLocation="CenterOwner"
        FontSize="{DynamicResource FontSize.Base}"
        WindowStyle="None" ResizeMode="CanResizeWithGrip">
    <!-- No AllowsTransparency: a layered (per-pixel transparent) window is missing from Windows'
         own screenshot tool (Win+Shift+S freezes the screen without it, so the window cannot be
         photographed). WindowChrome without a caption or glass frame removes the OS frame the way
         AllowsTransparency did, and keeps the resize edge. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <local:ClassIconConverter x:Key="ClassIconConverter"/>
        <local:RaceIconConverter x:Key="RaceIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Einstellungen A ("Seitenleiste", vom User gebilligter Prototyp): one row-style shared
             by the 5 sidebar RadioButtons below. Colors hard-coded navy/orange like the App-Menü
             flyout in MainWindow.xaml - same user decision ("Orange fest verdrahten"), same
             reasoning (no current theme has an orange accent). Foreground here becomes each
             RadioButton's own Foreground (muted by default, accent when checked - see the
             Trigger below); the icon Paths inside bind to it explicitly via
             RelativeSource/AncestorType since Path.Stroke isn't an inherited property the way
             TextBlock.Foreground is. -->
        <Style x:Key="SettingsNavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9db3c2"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1a2b38"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26405a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#ffba42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Pet page: the two tabs of "Shown pets" (Type / Region): text with an orange underline on the chosen one -->
        <Style x:Key="PetTab" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,6" Margin="0,0,4,-1" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#ffba42"/>
                                <Setter Property="Foreground" Value="#ffba42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetSplitter" TargetType="GridSplitter">
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Rectangle x:Name="Line" Width="1" Fill="{DynamicResource Brush.Border}" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="#ffba42"/>
                                <Setter TargetName="Line" Property="Width" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sammeln page: a collectible is a pill that lights up orange when it is on; "all / none" is a plain underlined link -->
        <Style x:Key="GatherPill" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="11,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFBA42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#ffba42"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GatherLink" TargetType="Button">
            <Setter Property="Foreground" Value="#ffba42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Every CheckBox in this dialog is an on/off setting, so it is drawn as a switch: label on
             the left (wraps), track on the right. Orange when on, the same accent the sidebar uses. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsSwitch}"/>
        <!-- A group of related settings: the page is a stack of these, each with a small heading. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Per the user: the border around each section was too heavy (the OS's own themed
             GroupBox chrome - there's no BorderThickness setter that touches it, same lesson as
             every other control this session; only a full template replacement does). Thin,
             flat 1px border instead, header sitting above it rather than notched into the line. -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="2,0,0,3"
                                              TextElement.FontWeight="SemiBold"/>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
                                <ContentPresenter Margin="6"/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}"/>
        </Style>
                <!-- Same dark ComboBox fix as MainWindow (see its Window.Resources comment for why a
             Background/Foreground setter alone doesn't do it) - ThemeBox/FontSizeBox were
             rendering with WPF's default light-theme chrome and popup otherwise. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <!-- One height for every dropdown and button in this dialog (Button style below), per the
                 user; titlebar buttons set their own Height explicitly. -->
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource Brush.TextSubtle}" Margin="0,0,8,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,3,20,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Same flat template as MainWindow's own implicit Button style (Ui/MainWindow.xaml) -
             per the user, whose new titlebar minimize/close glyphs ("─"/"✕") were hard to make out
             here: without this template override, WPF's DEFAULT button chrome (3D bevel, focus
             rectangle) was still in effect - Foreground alone changes the glyph's color, not the
             chunky default chrome it sits inside, which is what actually made it read differently
             from MainWindow's own flat titlebar buttons. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Window}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Learned from the DataGrid selection fix: a plain Background/BorderBrush setter is
             enough for ListBox's own chrome, but the selected-ITEM highlight is driven by
             SystemColors.Highlight* inside the default template regardless - overridden the same
             way, scoped to just this list (see the CharactersList.Resources below). -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>
        <!-- Same dark ToolTip fix as MainWindow - the class-name tooltips on the icon-only
             ComboBoxItems below would otherwise show a bright white box. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <!-- Same Border-carries-the-real-background pattern as MainWindow's own NormalContent - per
         the user, who spotted a thin white sliver at the top edge that MainWindow doesn't have.
         WindowStyle="None" + ResizeMode="CanResizeWithGrip" without AllowsTransparency leaves the
         OS drawing its own small non-client resize-border sliver in its default (light) color,
         since only AllowsTransparency hands the ENTIRE window surface to WPF's own content all the
         way to the true edge - Window.Background alone only ever painted the client area, not
         that sliver. -->
    <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
    <DockPanel LastChildFill="True">
        <!-- Same custom titlebar as MainWindow (App-Icon + title + minimize/close), per the user:
             this dialog previously kept the OS's own chrome (colored dark via DarkTitleBar's DWM
             call, but still not actually part of this app's UI) while the main window draws
             everything itself - the app icon in particular only ever showed here, not there,
             which is what prompted asking for the two to match. "✕" reuses OnCancelClicked (close
             without saving), the same as the OS close button always meant on this dialog. -->
        <Grid DockPanel.Dock="Top" Background="{DynamicResource Brush.TitleBar}" Height="30" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Image x:Name="AppIconImage" Width="16" Height="16" Margin="8,0,0,0" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="30,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="─" Click="OnMinimizeClicked" Width="28" Height="30"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextMuted}" Margin="0"/>
                <Button Content="✕" Click="OnCancelClicked" Width="28" Height="30"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.TextMuted}" Margin="0"/>
            </StackPanel>
        </Grid>
        <!-- Right/bottom margin keeps Cancel clear of the window's resize grip in the corner. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,22,8">
            <Button Content="{local:Loc Settings.Save}" Click="OnSaveClicked"/>
            <Button Content="{local:Loc Settings.Cancel}" Click="OnCancelClicked"/>
        </StackPanel>

        <!-- Einstellungen A ("Seitenleiste"): the ScrollViewer>StackPanel>5×GroupBox column this
             replaced is still exactly how MeterSettings.Load/Save and every OnXxx handler in
             SettingsWindow.xaml.cs expect to find these controls - only the SURROUNDING chrome
             changed (sidebar nav instead of one long scroll), every x:Name below is unchanged and
             in the same relative order. Categories are the same 5 as before (Aion-Installation /
             Charaktere / Ziele-Targets / Benutzeroberfläche / Updates) - NOT the 6-category split
             ("Allgemein"/"Anzeige") the HTML prototype explored, since that would restructure the
             settings themselves, not just their navigation (see the plan this was built from).
             GroupBox headers are gone: the sidebar names the category now, a second label would
             just repeat it. Colors: same "Orange fest verdrahten" decision as the App-Menü flyout
             - only this new chrome (sidebar background/active state/icons) is hard-coded
             navy/orange; the reused inner controls (ComboBox/CheckBox/TextBox above) keep their
             existing {DynamicResource Brush.*} bindings untouched. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#11202b" BorderBrush="#294557" BorderThickness="0,0,1,0">
                <StackPanel Margin="6">
                    <RadioButton x:Name="NavInstall" GroupName="SettingsNav" IsChecked="True" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,3 L12,3 L12,9 L2,9 Z M5,12 L9,12 M7,9 L7,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" Width="14" Height="12" Margin="0,0,7,0"/>
                            <TextBlock Text="{local:Loc Settings.AionInstallation}" TextWrapping="Wrap" Width="98" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavUi" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,7,0">
                                <Path Data="M1,4 L13,4 M1,10 L13,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,2,0,0"/>
                                <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,2"/>
                            </Grid>
                            <TextBlock Text="{local:Loc Settings.Nav.Interface}" TextWrapping="Wrap" Width="98" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHotkeys" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1,3 L13,3 L13,10 L1,10 Z M3,5.5 L4,5.5 M6,5.5 L7,5.5 M9,5.5 L10,5.5 M4,8 L10,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" Width="14" Height="12" Margin="0,0,7,0"/>
                            <TextBlock Text="{local:Loc Settings.Hotkeys}" TextWrapping="Wrap" Width="98" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTimetable" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,7,0">
                                <Ellipse Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Path Data="M7,4 L7,7 L9.5,8.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                            </Grid>
                            <TextBlock Text="{local:Loc Settings.Nav.Timetable}" TextWrapping="Wrap" Width="98" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPetMap" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,7,0">
                                <Path Data="M7,1 L7,13 M1,7 L13,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.1"/>
                                <Ellipse Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                            </Grid>
                            <TextBlock Text="{local:Loc Settings.Nav.PetMap}" TextWrapping="Wrap" Width="98" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPets" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}" Margin="22,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{local:Loc Settings.Nav.Pets}" TextWrapping="Wrap" Width="82" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGather" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}" Margin="22,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{local:Loc Settings.Nav.Gather}" TextWrapping="Wrap" Width="82" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBoss" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,7,0">
                                <Path Data="M2,6 Q2,1 7,1 Q12,1 12,6 L12,9 L9.5,9 L9.5,11 L8,11 L8,9 L6,9 L6,11 L4.5,11 L4.5,9 L2,9 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
                            </Grid>
                            <TextBlock Text="{local:Loc Settings.Nav.Boss}" TextWrapping="Wrap" Width="98" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavUpdates" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,6 L6,2 L6,5 L11,5 M11,6 L7,10 L7,7 L2,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" Width="14" Height="10" Margin="0,0,7,0"/>
                            <TextBlock Text="{local:Loc Settings.Updates}" TextWrapping="Wrap" Width="98" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="16,14,16,6">
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NavInstall, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:Loc Settings.Card.Capture}"/>
                            <TextBlock Style="{StaticResource CardHint}" Text="{local:Loc Settings.Aion2Hint}"/>
                                <Grid x:Name="CaptureAdapterPanel" Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:Loc Settings.CaptureAdapter}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CaptureAdapterBox" Grid.Column="1" Margin="0,2" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:Loc Settings.Card.Upload}"/>
                                <CheckBox x:Name="AutoUploadProfileBox" Content="{local:Loc Settings.AutoUploadProfile}"
                                          ToolTip="Uploads your own character (name, class, level, gear, skills, Daevanion, legion, server) a few seconds after you log in, so you can be found on aiondps.com. Nothing else is uploaded automatically unless you switch on the boss upload below."/>
                                <CheckBox x:Name="UploadOtherProfilesBox" Content="{local:Loc Settings.UploadOtherProfiles}"
                                          ToolTip="Also sends the profiles of other players the meter has seen (name, class, level, gear, legion) with your own profile, the Upload button and boss uploads. Off by default: with it off only your own character is sent."/>
                                <CheckBox x:Name="AutoUploadBossBox" Content="{local:Loc Settings.AutoUploadBoss}"
                                          ToolTip="Uploads the fight to aiondps.com a few seconds after a boss died, the same as the Upload button. Off by default."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
