                                    <Button Grid.Column="2" Tag="HotkeyModeBox" Click="OnHotkeyClearClicked" Height="28" Width="28" Margin="6,2,0,2" Padding="0"
                                            Content="✕" ToolTip="{local:Loc Settings.Hotkey.Clear.Tip}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NavTimetable, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:Loc Settings.Hotkey.Timetable}"/>
