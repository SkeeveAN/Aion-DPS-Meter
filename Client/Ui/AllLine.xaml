<UserControl x:Class="AionDPS.Ui.AllLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The second line of a row in the All in One Compact mode: a green cross with the healing, a red shield
         with the damage taken. Collapsed (no height) in every other mode. DataContext is the PlayerRow. -->
    <!-- The columns share their widths across all rows (the list is a shared size scope), so the heal, the red
         and the blue figures each stand under one another. -->
    <Grid>
        <Grid.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="AllLineHeal"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="AllLineTaken"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="AllLineAbsorbedIcon"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="AllLineAbsorbed"/>
        </Grid.ColumnDefinitions>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AllCompact}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Path Grid.Column="0" Data="M4.4,1 H7.6 V4.4 H11 V7.6 H7.6 V11 H4.4 V7.6 H1 V4.4 H4.4 Z" Fill="{DynamicResource Brush.Heal}"
              Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
        <TextBlock Grid.Column="1" Text="{Binding HealCompact}" Margin="4,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Path Grid.Column="2" Data="M6,0.8 L10.6,2.4 V5.7 C10.6,8.2 8.8,10.3 6,11.3 C3.2,10.3 1.4,8.2 1.4,5.7 V2.4 Z" Fill="#FF3B3B"
              Width="10" Height="11" Stretch="Uniform" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
        <TextBlock Grid.Column="3" Text="{Binding TakenCompact}" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <!-- What the group shield absorbed on this player: the blue part of the damage taken. -->
        <Path Grid.Column="4" Data="M6,0.8 L10.6,2.4 V5.7 C10.6,8.2 8.8,10.3 6,11.3 C3.2,10.3 1.4,8.2 1.4,5.7 V2.4 Z" Fill="#3AA0FF" Margin="10,0,0,0"
              Width="10" Height="11" Stretch="Uniform" VerticalAlignment="Center" SnapsToDevicePixels="True"
              Visibility="{Binding HasAbsorbed, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Grid.Column="5" Text="{Binding AbsorbedCompact}" Foreground="#3AA0FF" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
