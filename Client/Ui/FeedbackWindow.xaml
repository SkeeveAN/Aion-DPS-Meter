<Window x:Class="AionDPS.Ui.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionDPS.Ui"
        Title="{local:Loc Feedback.Title}" Height="620" Width="760" MinWidth="560" MinHeight="520"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontSize="{DynamicResource FontSize.Base}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20,12,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Hint}" Text="{local:Loc Feedback.Intro}" Margin="0,0,0,2"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc Feedback.Type}"/>
                <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch" SelectedIndex="1">
                    <ComboBoxItem Tag="feature" Content="{local:Loc Feedback.Type.Feature}"/>
                    <ComboBoxItem Tag="issue" Content="{local:Loc Feedback.Type.Issue}"/>
                    <ComboBoxItem Tag="improvement" Content="{local:Loc Feedback.Type.Improvement}"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc Feedback.Name}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Field}" MaxLength="80"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc Feedback.Email}"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource Field}" MaxLength="200"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Text="{local:Loc Feedback.EmailHint}"/>
            <Grid Grid.Row="3" Grid.ColumnSpan="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="{local:Loc Feedback.Message}"/>
                <TextBox x:Name="MessageBox" Grid.Row="1" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MaxLength="5000" MinHeight="140"/>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <CheckBox x:Name="RecordingBox" Content="{local:Loc Feedback.IncludeRecording}"/>
            <TextBlock x:Name="RecordingHint" Style="{StaticResource Hint}" Margin="0,0,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="3" Margin="0,12,22,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SendButton" Content="{local:Loc Feedback.Send}" Click="OnSendClicked" MinWidth="90"/>
                <Button Content="{local:Loc Settings.Cancel}" Click="OnCancelClicked" MinWidth="90"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
