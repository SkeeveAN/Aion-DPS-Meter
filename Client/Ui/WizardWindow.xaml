<Window x:Class="AionDPS.Ui.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionDPS.Ui"
        Title="{local:Loc Wizard.Title}" Width="500" SizeToContent="Height" MinWidth="440" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontSize="{DynamicResource FontSize.Base}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <!-- The same switches and cards as the Settings window, so the wizard looks like it. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.CheckBorder}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource Brush.TextSubtle}"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#ffba42"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#ffba42"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#1a1205"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.CheckBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24,18,24,16">
        <TextBlock Style="{StaticResource Heading}" Text="{local:Loc Wizard.LanguageHeading}"/>
        <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" MinWidth="220" SelectionChanged="OnLanguageChanged"/>
        <TextBlock Style="{StaticResource Hint}" Text="{local:Loc Wizard.LanguageHint}"/>

        <Separator Margin="0,16,0,14"/>

        <TextBlock Style="{StaticResource Heading}" Text="{local:Loc Wizard.PrivacyHeading}"/>
        <TextBlock TextWrapping="Wrap" Text="{local:Loc Wizard.PrivacyText}"/>
        <Border Style="{StaticResource SettingsCard}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{local:Loc Settings.Card.Upload}"/>
                <CheckBox x:Name="ProfileBox" Content="{local:Loc Wizard.OptProfile}"/>
                <CheckBox x:Name="OthersBox" Content="{local:Loc Wizard.OptOthers}"/>
                <CheckBox x:Name="BossBox" Content="{local:Loc Wizard.OptBoss}"/>
            </StackPanel>
        </Border>

        <Button Content="{local:Loc Wizard.Finish}" Click="OnFinishClicked" MinWidth="110" IsDefault="True"
                HorizontalAlignment="Right" Margin="0,6,0,0"/>
    </StackPanel>
</Window>
