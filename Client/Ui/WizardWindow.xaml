<Window x:Class="AionDPS.Ui.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionDPS.Ui"
        Title="{local:Loc Wizard.Title}" Width="680" SizeToContent="Height" MinWidth="680" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontSize="{DynamicResource FontSize.Base}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <!-- The same switches and cards as the Settings window, so the wizard looks like it. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.CheckBorder}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource Brush.TextSubtle}"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#ffba42"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#ffba42"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#1a1205"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.CheckBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StepText" Style="{StaticResource Hint}" Margin="0,0,0,10" FontSize="11"/>

        <!-- One question per page. Every page sits in the same cell and the others are only Hidden, so the window is as big as the biggest page needs. -->
        <Grid Grid.Row="1">
            <StackPanel x:Name="PageLanguage">
                <TextBlock Style="{StaticResource Heading}" Text="{local:Loc Wizard.LanguageHeading}"/>
                <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" MinWidth="240" SelectionChanged="OnLanguageChanged"/>
                <TextBlock Style="{StaticResource Hint}" Text="{local:Loc Wizard.LanguageHint}"/>
            </StackPanel>

            <StackPanel x:Name="PagePolicy" Visibility="Hidden">
                <TextBlock Style="{StaticResource Heading}" Text="{local:Loc Wizard.PolicyHeading}"/>
                <ContentControl x:Name="PolicyHost" Focusable="False"/>
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink NavigateUri="https://aiondps.com/privacy" RequestNavigate="OnPolicyLinkNavigate"><Run Text="{local:Loc Privacy.Link}"/></Hyperlink>
                </TextBlock>
                <RadioButton x:Name="PolicyAccept" GroupName="Policy" Margin="0,14,0,0" Foreground="{DynamicResource Brush.Text}" Checked="OnPolicyChanged">
                    <TextBlock TextWrapping="Wrap" Text="{local:Loc Wizard.PolicyAccept}"/>
                </RadioButton>
                <RadioButton x:Name="PolicyDecline" GroupName="Policy" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text}" Checked="OnPolicyChanged">
                    <TextBlock TextWrapping="Wrap" Text="{local:Loc Wizard.PolicyDecline}"/>
                </RadioButton>
            </StackPanel>

            <StackPanel x:Name="PageUploads" Visibility="Hidden">
                <TextBlock Style="{StaticResource Heading}" Text="{local:Loc Wizard.PrivacyHeading}"/>
                <TextBlock TextWrapping="Wrap" Text="{local:Loc Wizard.PrivacyText}"/>
                <Border x:Name="UploadCard" Style="{StaticResource SettingsCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{local:Loc Settings.Card.Upload}"/>
                        <CheckBox x:Name="ProfileBox" Content="{local:Loc Wizard.OptProfile}"/>
                        <CheckBox x:Name="OthersBox" Content="{local:Loc Wizard.OptOthers}"/>
                        <CheckBox x:Name="BossBox" Content="{local:Loc Wizard.OptBoss}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="PageReady" Visibility="Hidden">
                <TextBlock Style="{StaticResource Heading}" Text="{local:Loc Wizard.SetupHeading}"/>

                <!-- the checklist: a green tick behind what is done, a "?" with the explanation -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NpcapMark" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NpcapText" Grid.Column="1" VerticalAlignment="Center"/>
                    <Button x:Name="NpcapButton" Grid.Column="2" Content="{local:Loc Wizard.NpcapDownload}" Click="OnNpcapDownloadClicked" Margin="12,0,8,0" Padding="10,3" Visibility="Collapsed"/>
                    <Border x:Name="NpcapTip" Grid.Column="3" Width="20" Height="20" CornerRadius="10" BorderThickness="1" Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.Border}"
                            VerticalAlignment="Center" Cursor="Help" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000">
                        <TextBlock Text="?" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSubtle}"/>
                    </Border>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CharMark" FontSize="16" FontWeight="Bold" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="CharacterText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SwitchHint" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{local:Loc Wizard.SwitchHint}"/>
                    </StackPanel>
                    <Border x:Name="CharTip" Grid.Column="2" Width="20" Height="20" CornerRadius="10" BorderThickness="1" Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.Border}"
                            VerticalAlignment="Top" Cursor="Help" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000">
                        <TextBlock Text="?" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSubtle}"/>
                    </Border>
                </Grid>

                <!-- the characters of the account the game told about at the login (only the one logged in is seen live) -->
                <Border x:Name="CharsCard" Style="{StaticResource SettingsCard}" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{local:Loc Wizard.CharsHeading}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="CharsTime" Style="{StaticResource CardTitle}" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                        </Grid>
                        <StackPanel x:Name="CharRows"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="{local:Loc Wizard.CharsHint}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="2" Margin="0,16,0,12" VerticalAlignment="Top"/>
        <DockPanel Grid.Row="2" Margin="0,30,0,0">
            <Button x:Name="BackButton" Content="{local:Loc Wizard.Back}" Click="OnBackClicked" MinWidth="110" DockPanel.Dock="Left"/>
            <Button x:Name="NextButton" Content="{local:Loc Wizard.Next}" Click="OnNextClicked" MinWidth="110" IsDefault="True" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
