<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="AionDPS.app"/>

  <!-- requireAdministrator, per the user: back to needing elevation, this time for Aion 2's real
       packet capture (Aion2/, via SharpPcap/Npcap - opening the Npcap driver handle needs admin
       rights, unlike classic Aion's Chat.log reading, which never did). An earlier version of this
       manifest was "asInvoker" for exactly that reason (classic Aion only), with Program.Main
       re-launching itself through the "runas" verb earlier still, back when packet capture first
       existed - both are gone now in favor of the OS just enforcing it here: Windows shows the UAC
       prompt on every launch (double-click, shortcut, Velopack's own relaunch after an update) and
       refuses to start at all without it, for both games now, not only when Aion 2 is selected.
       Settings still live outside the install directory (MeterSettings.SettingsPath) regardless -
       that was never about elevation, just about the per-user Velopack install layout. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Without this block Windows reports 6.2 for every later version, which is what the
       framework's own default manifest declares; kept in sync with net10.0-windows' supported set
       (Windows 7 through 11/Server 2022). -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
