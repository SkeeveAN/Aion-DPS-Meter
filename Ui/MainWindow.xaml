<Window x:Class="AionSniffer.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionSniffer.Ui"
        Title="AionSniffer DMG Meter" Height="492" Width="357"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <local:ClassIconConverter x:Key="ClassIconConverter"/>
        <local:RaceIconConverter x:Key="RaceIconConverter"/>
        <local:ItemGradeColorConverter x:Key="ItemGradeColorConverter"/>
        <!-- Found by the user (left nav rail looked bright/white), then found AGAIN by
             terminal_windows measuring actual rendered pixels after the first fix: BasedOn alone
             fixed enabled buttons, but the four disabled nav buttons still rendered #F4F4F4 -
             WPF's default ButtonChrome template has its own IsEnabled=False trigger that sets a
             light background, and a template trigger always wins over a Style setter, inherited
             or not. Setters can never out-rank the default template's own triggers; only
             replacing the template does. Full custom template below: a plain Border + trigger for
             hover/pressed/disabled, so disabled means "dimmed", not "WPF's stock light chrome". -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2a2a33"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="BorderBrush" Value="#3a3a45"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34343f"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1e1e24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- NavButton (below) is a keyed style with no BasedOn, so it replaces the implicit
             Button style above entirely instead of adding to it - it only ever set
             Width/Height/Margin, leaving colors/template at WPF's defaults. BasedOn fixes it. -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <!-- Per the user: the Copy/CopyAll/Pause/EmptyChatLog/Clear/HideUi icon row (shared by the
             Damage and Loot views) sat only one shade above the toolbar's own #26262e background
             (#2a2a33 idle), which barely separated the icon chips from their surroundings. A full
             template copy rather than a BasedOn override of just the Background setter: the
             default Button template's hover/pressed colors (#34343f/#1e1e24) are hardcoded inside
             its ControlTemplate.Triggers, not TemplateBinding'd, so a lighter idle color alone
             would leave hover barely distinguishable from idle (or, worse, darker than it). -->
        <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#34343f"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40404e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26262e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Same root cause, different control: an implicit ComboBox style only setting
             Margin/MinWidth does nothing to the default WPF chrome, which is light-themed
             regardless of the window's own colors (the closed box AND, worse, the dropdown
             popup - a bright white list floating over a dark window). Setting Background/
             Foreground alone does not fix a ComboBox the way it does a Button, because the
             default ComboBox ControlTemplate does not consistently use those properties for its
             chrome; only a full template replacement reliably does. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#26262e"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3a3a45"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3a3a45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Found by the user from a screenshot after the ComboBox/NavButton fix: the DataGrid's
             column header row was still bright white - unlike ComboBox, DataGridColumnHeader's
             default template DOES respect a plain Background/Foreground/BorderBrush setter, it
             just never had one set in the first place. -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#26262e"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="BorderBrush" Value="#3a3a45"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <!-- The other bright spot terminal_windows measured (#CDCDCD): WPF's default ScrollBar
             chrome, which appears once the player list has more rows than fit. Minimal track +
             thumb template, no visible arrow buttons (a deliberate simplification, not an
             oversight - the invisible full-length RepeatButtons still make clicking the empty
             track above/below the thumb page-scroll normally, they're just not drawn). -->
        <Style x:Key="DarkScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#4a4a55" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1e1e24"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumb}" Margin="2"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="MinWidth" Value="110"/>
            <!-- Per the user: the closed box previously matched the surrounding toolbar/window
                 background (#26262e) almost exactly, so the three filter dropdowns barely read as
                 controls. A distinct, still-dark shade here - the dropdown POPUP below keeps
                 #26262e on purpose, so the open list still matches the rest of the app's flyouts. -->
            <Setter Property="Background" Value="#32323e"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="BorderBrush" Value="#3a3a45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="#c8c8ce" Margin="0,0,8,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,3,20,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#26262e" BorderBrush="#3a3a45" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Per the user: the Mob/Boss target dropdown needed a search box, filtering the list as
             you type by substring ("like '%word%'"), not just WPF's own built-in type-ahead (which
             only matches from the start of an item's text). A ComboBox's normal IsEditable="True"
             would need this template to define a PART_EditableTextBox, replacing the closed box's
             own display - not what's wanted here, since the closed box should keep showing the
             CURRENT SELECTION, not become a typing field itself. Instead, PART_SearchBox lives
             inside the dropdown POPUP, above the list, exactly where MainWindow.xaml.cs's
             ApplyMobBossSearchFilter expects to find it (via Template.FindName, wired up once in
             OnWindowLoaded) - it only affects what the OPEN list shows, never the closed box. -->
        <Style x:Key="SearchableComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="#c8c8ce" Margin="0,0,8,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,3,20,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#26262e" BorderBrush="#3a3a45" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <DockPanel>
                                        <TextBox x:Name="PART_SearchBox" DockPanel.Dock="Top"
                                                 Background="#1e1e24" Foreground="#e8e8ea"
                                                 BorderBrush="#3a3a45" BorderThickness="0,0,0,1"
                                                 Padding="5,4" Margin="0"/>
                                        <ScrollViewer SnapsToDevicePixels="True" MaxHeight="240">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Found by the user from a screenshot: opening a menu (e.g. "Mode") dropped a bright
             white submenu popup. The Menu bar itself already looked dark because its own
             Background was set directly in the XAML below, but a submenu's popup is a separate
             visual tree that draws from SystemColors.Menu*, not from that Background property -
             same family of bug as the ComboBox/DataGrid/ListBox fixes above, different keys.
             Scoped to Window.Resources (not the Menu element) because these specific keys don't
             overlap with the Highlight* keys already scoped to the DataGrid/ListBox, so there's
             no risk of the two fixes fighting each other. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#26262e"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#e8e8ea"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#3a3a45"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#26262e"/>
        <!-- Found by the user: menu items rendered with an ugly per-item border/bevel. Same
             lesson as Button/ComboBox/CheckBox before it - a Background/Foreground setter alone
             leaves whatever border/bevel chrome the default MenuItem template draws untouched;
             only replacing the template removes it. One template covers top-level headers (App,
             Session, Settings, Mode), leaf items with no children (Close, Load Demo Data, ...), and
             submenu entries - WPF's MenuItem is the same class for all three, distinguished only
             by its Role property, which the Popup.Placement trigger below accounts for. -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#26262e"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Check" Grid.Column="0" Data="M 2,7 L 6,11 L 12,3" Stroke="#e8e8ea"
                                          StrokeThickness="1.6" Margin="0,0,8,0" Visibility="Collapsed"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#26262e" BorderBrush="#3a3a45" BorderThickness="1">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3a3a45"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6a6a75"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="Popup" Property="Placement" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#3a3a45"/>
        </Style>
        <!-- Found by the user: a ToolTip popup (e.g. the Char-quick-switch's, back when it still
             existed) rendered as a bright white box - same popup-chrome issue as everything above, ToolTip's default template
             ignores Background/Foreground the same way. Simple setters ARE enough here (ToolTip's
             default template is a plain bordered box, no bevel/3D chrome to fight). -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#26262e"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="BorderBrush" Value="#3a3a45"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <!-- Found by terminal_windows measuring pixels again: a CheckBox's own box (the now-removed
             PlayersOnlyFilter toggle, back when it still existed) drew pure white - the same family
             of bug as the disabled-Button chrome earlier, a Foreground setter never reaches the box,
             only its default template does. Full template: a small dark Border for the box, a
             checkmark Path shown only when checked. Kept for the CheckBoxes still in this window's
             menus and any future toggle. -->
        <Style TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="14" Height="14" Background="#26262e"
                                    BorderBrush="#5a5a66" BorderThickness="1" Margin="0,0,6,0">
                                <Path x:Name="Check" Data="M 2,7 L 6,11 L 12,3" Stroke="#e8e8ea"
                                      StrokeThickness="1.6" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#8a8a99"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ================= Normal mode ================= -->
        <!-- WindowStyle="None" on the Window (needed so "Hide UI" can make the whole surface
             transparent+click-through) means there's no OS titlebar - this Border supplies its
             own dark background (so normal mode looks the way it always did) plus a manual
             drag/close bar, since we gave up the OS one. -->
        <Border x:Name="NormalContent" Background="#1e1e24" BorderBrush="#3a3a45" BorderThickness="1">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Background="#151519" Height="24" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <!-- Per the user: the version belongs where it's actually seen. Window.Title
                         already carries it (set in the constructor from AppVersion.Text, see its
                         remarks on why a screenshot needs to identify its build), but WindowStyle=
                         "None" means the OS never draws that text anywhere; this hand-drawn bar is
                         the only titlebar a user ever sees, so it has to show the same string
                         rather than a second, separately-hardcoded one that could drift from it. -->
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="#9a9aa2" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Content="✕" Click="OnCloseClicked" HorizontalAlignment="Right" Width="28" Height="24"
                            Background="Transparent" BorderThickness="0" Foreground="#9a9aa2" Margin="0"/>
                </Grid>

                <!-- Top menu bar: App / Session / Settings / Mode. The original
                     App/Session/Mode set matched the myaion.eu reference; Settings was
                     split out of App into its own dropdown per the user's request, since App had
                     grown into one long grab-bag of session/dev/settings items with no fixed place
                     to look for any one of them. Most remaining "App" items are placeholders (no
                     session persistence, no tray icon, no auto-update, no auto-start-with-Windows
                     - the last one specifically not implemented here even as a stub, since
                     silently writing to the Windows Run registry key on click would be exactly the
                     kind of action that needs an explicit ask first, not a UI-parity checkbox).
                     What IS real: Close, Load Demo Data, Clear sessions, and everything under
                     Settings. -->
                <Menu DockPanel.Dock="Top" Background="#26262e" Foreground="#e8e8ea">
                    <MenuItem Header="{local:Loc Main.MenuApp}" Foreground="#e8e8ea">
                        <MenuItem Header="{local:Loc Main.MenuApp.LoadSession}" IsEnabled="False"/>
                        <MenuItem Header="{local:Loc Main.MenuApp.SaveSession}" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Main.MenuApp.ExportSession}" IsEnabled="False"/>
                        <MenuItem Header="{local:Loc Main.MenuApp.ValidateSession}" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Main.MenuApp.OpenSessionsFolder}" IsEnabled="False"/>
                        <MenuItem Header="{local:Loc Main.MenuApp.OpenLogsFolder}" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Main.MenuApp.ResetConnection}" IsEnabled="False"/>
                        <MenuItem Header="{local:Loc Main.MenuApp.ClearCurrentView}" Click="OnClearClicked"/>
                        <!-- Explicit, opt-in exception to ChatLogTailer's "never look into the
                             past" rule (see its own remarks) - recovers a run lost when the app
                             itself restarts (crash, or an auto-update), since Chat.log on disk
                             still has it even though _aggregator's in-memory events don't survive
                             a restart. Never runs on its own; only this menu click triggers it. -->
                        <MenuItem Header="{local:Loc Main.MenuApp.ReloadChatLog}" Click="OnReloadChatLogClicked"
                                  ToolTip="Re-reads the entire Chat.log file and replaces the current session with it - use after a restart/update wiped an in-progress run, since the live recorder itself never looks at anything before it started."/>
                        <!-- Moved out of the toolbar (found by terminal_windows: the toolbar
                             overflowed the window at its default width once Char/Hide UI grew it,
                             literally pushing Settings off-screen and unreachable) - a synthetic
                             data loader is a dev/test aid, not something reached every session. -->
                        <MenuItem Header="{local:Loc Main.MenuApp.LoadDemoData}" Click="OnLoadDemoDataClicked"
                                  ToolTip="Fills the grid with synthetic data (same numbers as the selftest), for visually checking the UI without playing."/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Main.MenuApp.CheckForUpdates}" Click="OnCheckForUpdatesClicked"/>
                        <MenuItem Header="{local:Loc Main.MenuApp.StartWithWindows}" IsEnabled="False"
                                  ToolTip="Not implemented on purpose: would write to the Windows startup registry key, a system-wide change that needs an explicit ask, not a UI-parity checkbox."/>
                        <MenuItem Header="{local:Loc Main.MenuApp.MinimizeToTray}" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Main.MenuApp.Close}" Click="OnCloseClicked"/>
                    </MenuItem>
                    <MenuItem x:Name="SessionMenu" Header="{local:Loc Main.MenuSession}" Foreground="#e8e8ea">
                        <!-- Uploads exactly the currently filtered boss - same action as the
                             Damage view's Upload button (OnUploadCurrentBossClicked), reachable
                             here too since the button only shows in that one view. Collapsed by
                             default (per the user: no point offering an upload with nothing
                             recorded to upload yet) - RefreshUploadAvailability shows it again the
                             moment the Mob/Boss filter has at least one real target. -->
                        <MenuItem x:Name="UploadBossMenuItem" Header="{local:Loc Main.MenuSession.UploadBoss}" Click="OnUploadCurrentBossClicked"
                                  Visibility="Collapsed"
                                  ToolTip="Uploads the fight currently selected in the Mob/Boss filter to dpsmeter.skeeve.tv."/>
                        <!-- Everything the Mob/Boss filter has accumulated since the last Clear -
                             one upload request per boss, so a group that split the upload across
                             its members still gets recognized as one run server-side (see
                             backend/src/matching/merge.ts). Same Collapsed-until-there's-something
                             rule as UploadBossMenuItem above. -->
                        <MenuItem x:Name="UploadRunMenuItem" Header="{local:Loc Main.MenuSession.UploadRun}" Click="OnUploadLastRunClicked"
                                  Visibility="Collapsed"
                                  ToolTip="Uploads every boss fight recorded since the last Clear, one by one, to dpsmeter.skeeve.tv."/>
                    </MenuItem>
                    <!-- Consolidated here from the App menu, per the user's request - App had
                         become a long, mixed grab-bag of session/dev/settings items; splitting
                         out everything settings-related into its own top-level dropdown (right of
                         Session) makes it a fixed, predictable place to look, rather than one more
                         entry buried among a dozen others. -->
                    <MenuItem Header="{local:Loc Main.MenuSettings}" Foreground="#e8e8ea">
                        <MenuItem Header="{local:Loc Main.MenuSettings.AppSettings}" Click="OnSettingsClicked"/>
                        <MenuItem Header="{local:Loc Main.MenuSettings.PlayerDatabase}" Click="OnPlayerDatabaseClicked"
                                  ToolTip="Everyone the meter has identified, with their class and faction - and where a wrongly derived faction can be corrected later."/>
                        <MenuItem x:Name="AlwaysOnTopMenuItem" Header="{local:Loc Main.MenuSettings.AlwaysOnTop}" IsCheckable="True" Click="OnAlwaysOnTopClicked"/>
                        <Separator/>
                        <MenuItem Header="{local:Loc Main.MenuSettings.ProfileSettings}" IsEnabled="False"/>
                        <MenuItem Header="{local:Loc Main.MenuSettings.KeyBindings}" IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem Header="{local:Loc Main.MenuMode}" Foreground="#e8e8ea">
                        <MenuItem x:Name="DamageModeItem" Header="{local:Loc Main.ModeDamage}" IsCheckable="True" IsChecked="True" Click="OnModeClicked"/>
                        <MenuItem x:Name="HealModeItem" Header="{local:Loc Main.ModeHeal}" IsCheckable="True" Click="OnModeClicked"
                                  ToolTip="Not implemented: SM_ATTACK_STATUS (the heal-tick packet) carries no healer/attacker field in this build's layout, so heals can't be attributed to a player - see README."/>
                        <MenuItem x:Name="RelicModeItem" Header="{local:Loc Main.ModeRelic}" IsCheckable="True" Click="OnModeClicked"
                                  ToolTip="Not implemented: no relic/AP/GP packet source wired up yet."/>
                    </MenuItem>
                </Menu>

                <!-- Top toolbar: matches MyAion's Copy / Copy All / Pause / Clear / Hide UI row.
                     All five are icon-only per the user's request ("... alle mit Tooltip bitte") -
                     each ToolTip is the only remaining explanation of what a button does, same
                     pattern as HideUiButton below. Copy/CopyAll use an overlapping-rectangles glyph
                     (2 rects for Copy, 3 for CopyAll, to visually hint "more"); the back rect(s) are
                     given the toolbar's own Background as Fill so the front rect's edge reads as an
                     overlap rather than a plus-sign of crossing lines. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#26262e">
                    <!-- Icon vs text label toggled per view (see OnShowDamageView/OnShowLootView)
                         - per the user: while the Loot view is active, Copy and CopyAll produce
                         genuinely different payloads (chat string vs Discord table, see
                         OnCopyClicked/OnCopyAllClicked) and a generic icon no longer says which is
                         which. The Damage view still shows the plain icon, though its two buttons
                         now differ as well (chat string vs tab-separated table). Left as-is
                         because the user asked only for the missing payload, not a toolbar
                         change; showing the labels there too would apply the same reasoning. -->
                    <!-- Same two buttons in both views, per the user: an "A" for the chat string
                         and Discord's own mark for the table. They used to swap between an icon and
                         a text label depending on the active view, which meant the same button
                         looked like two different controls. -->
                    <Button x:Name="CopyButton" Style="{StaticResource ToolbarIconButton}" Click="OnCopyClicked" Padding="6,4"
                            ToolTip="Copy a one-line chat string - the damage ranking, or an Aion-chat loot summary if the Loot view is active.">
                        <Grid Width="18" Height="16">
                            <TextBlock Text="A" FontSize="15" FontWeight="Bold" Foreground="#e8e8ea"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <!-- The pair differs by FORMAT, not by row selection: both cover the rows the
                         grid is showing (no per-source filter exists yet for "all" to differ from
                         "visible"), but Copy yields the one-line chat string and CopyAll the
                         tab-separated table, which is what the String/Table labels say. -->
                    <Button x:Name="CopyAllButton" Style="{StaticResource ToolbarIconButton}" Click="OnCopyAllClicked" Padding="6,4"
                            ToolTip="Copy an ASCII table in a code block, ready to paste into Discord - damage, or loot if the Loot view is active.">
                        <Grid Width="18" Height="16">
                            <!-- Discord's own mark, from the simple-icons 24x24 viewBox. The SVG
                                 packs arc flags ("0 0 0-4.88"), which WPF's geometry parser rejects,
                                 so the flags are spaced out and bare ".5" numbers are written "0.5".
                                 SelfCheck parses this string, because a malformed Data attribute
                                 throws while the window is being built - the app would not start. -->
                            <Path Data="M 20.317 4.3698a 19.7913 19.7913 0 0 0 -4.8851 -1.5152 0.0741 0.0741 0 0 0 -0.0785 0.0371c -0.211 0.3753 -0.4447 0.8648 -0.6083 1.2495 -1.8447 -0.2762 -3.68 -0.2762 -5.4868 0 -0.1636 -0.3933 -0.4058 -0.8742 -0.6177 -1.2495a 0.077 0.077 0 0 0 -0.0785 -0.037 19.7363 19.7363 0 0 0 -4.8852 1.515 0.0699 0.0699 0 0 0 -0.0321 0.0277C 0.5334 9.0458 -0.319 13.5799 0.0992 18.0578a 0.0824 0.0824 0 0 0 0.0312 0.0561c 2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a 0.0777 0.0777 0 0 0 0.0842 -0.0276c 0.4616 -0.6304 0.8731 -1.2952 1.226 -1.9942a 0.076 0.076 0 0 0 -0.0416 -0.1057c -0.6528 -0.2476 -1.2743 -0.5495 -1.8722 -0.8923a 0.077 0.077 0 0 1 -0.0076 -0.1277c 0.1258 -0.0943 0.2517 -0.1923 0.3718 -0.2914a 0.0743 0.0743 0 0 1 0.0776 -0.0105c 3.9278 1.7933 8.18 1.7933 12.0614 0a 0.0739 0.0739 0 0 1 0.0785 0.0095c 0.1202 0.099 0.246 0.1981 0.3728 0.2924a 0.077 0.077 0 0 1 -0.0066 0.1276 12.2986 12.2986 0 0 1 -1.873 0.8914 0.0766 0.0766 0 0 0 -0.0407 0.1067c 0.3604 0.698 0.7719 1.3628 1.225 1.9932a 0.076 0.076 0 0 0 0.0842 0.0286c 1.961 -0.6067 3.9495 -1.5219 6.0023 -3.0294a 0.077 0.077 0 0 0 0.0313 -0.0552c 0.5004 -5.177 -0.8382 -9.6739 -3.5485 -13.6604a 0.061 0.061 0 0 0 -0.0312 -0.0286zM 8.02 15.3312c -1.1825 0 -2.1569 -1.0857 -2.1569 -2.419 0 -1.3332 0.9555 -2.4189 2.157 -2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332 -0.9555 2.4189 -2.1569 2.4189zm 7.9748 0c -1.1825 0 -2.1569 -1.0857 -2.1569 -2.419 0 -1.3332 0.9554 -2.4189 2.1569 -2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332 -0.946 2.4189 -2.1568 2.4189Z"
                                  Fill="#e8e8ea" Stretch="Uniform" Width="16" Height="16"/>
                        </Grid>
                    </Button>
                    <!-- Pause/Resume: one button, two overlaid glyphs (pause bars / play triangle)
                         with only one Visible at a time - toggled in OnPauseClicked alongside the
                         ToolTip text, since the icon alone no longer carries the word "Resume".
                         Paused Chat.log lines are read but discarded, never replayed on Resume -
                         see ChatLogTailer's "never look into the past" rule for why. -->
                    <Button x:Name="PauseButton" Style="{StaticResource ToolbarIconButton}" Click="OnPauseClicked" Padding="6,4"
                            ToolTip="Pause recording.">
                        <Grid Width="18" Height="16">
                            <StackPanel x:Name="PauseIcon" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="4" Height="14" Fill="#e8e8ea" Margin="0,0,3,0"/>
                                <Rectangle Width="4" Height="14" Fill="#e8e8ea"/>
                            </StackPanel>
                            <Path x:Name="PlayIcon" Data="M3,1 L3,15 L15,8 Z" Fill="#e8e8ea" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <!-- Empties Aion's Chat.log itself, which nothing else in the game or the
                         meter ever does: the client only ever appends to it. Sits next to Clear
                         because both are "throw data away", but they touch different things:
                         Clear resets the view, this one rewrites a file on disk. -->
                    <Button x:Name="EmptyChatLogButton" Style="{StaticResource ToolbarIconButton}" Click="OnEmptyChatLogClicked" Padding="6,4"
                            ToolTip="Empty Aion's Chat.log on disk. The meter keeps running; only the file's history is discarded.">
                        <Grid Width="18" Height="16">
                            <Path Data="M4,1 L11,1 L14,4 L14,15 L4,15 Z M11,1 L11,4 L14,4"
                                  Stroke="#e8e8ea" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                            <Path Data="M6,8 L12,13 M12,8 L6,13" Stroke="#e8a0a0" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Button>
                    <!-- Per the user: a red X instead of the trash-can outline - same button
                         either way (OnClearClicked/ClearActiveView clears whichever of Damage/Loot
                         is the active view), so this one icon change covers both tabs. Red matches
                         the same accent already used for the destructive X on EmptyChatLogButton
                         above and the Player Database's own delete action. -->
                    <Button x:Name="ClearButton" Style="{StaticResource ToolbarIconButton}" Click="OnClearClicked" Padding="6,4"
                            ToolTip="Clear the view you are looking at - damage or loot, not both (does not touch Chat.log itself).">
                        <Grid Width="18" Height="16">
                            <Path Data="M4,3 L14,13 M14,3 L4,13" Stroke="#e0464f" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Button>
                    <!-- Icon instead of text, per the user's request - a simple vector eye glyph
                         (no bitmap asset exists for this, unlike the class icons, so drawn inline)
                         rather than the word "Hide UI". ToolTip is kept, per the same request, as
                         the only remaining explanation of what it does - trimmed to one line after
                         terminal_windows flagged the original ~500-char version as unreadable hover
                         text over a 32px icon. Full behavior, for reference: forces Always-on-Top
                         and hides the taskbar entry while active (restoring both on exit, since a
                         click-through overlay sitting behind the game or cluttering the taskbar
                         would defeat the point); the button itself becomes unreachable once the
                         window is click-through, which is why Ctrl+Alt+H exists to bring it back. -->
                    <Button x:Name="HideUiButton" Style="{StaticResource ToolbarIconButton}" Click="OnHideUiClicked" Padding="6,4"
                            ToolTip="Overlay mode: transparent, click-through, shows a small DPS chip per player. Ctrl+Alt+H brings the UI back.">
                        <Path Data="M1,12 C1,12 4.5,5 12,5 19.5,5 23,12 23,12 23,12 19.5,19 12,19 4.5,19 1,12 1,12 Z
                                    M12,15 A3,3 0 1 0 12,9 3,3 0 1 0 12,15 Z"
                              Fill="#e8e8ea" Width="18" Height="14" Stretch="Uniform"/>
                    </Button>
                    <!-- Moved here from the filter-dropdown row, per the user: it belongs in the
                         icon row next to the other actions, not off to the right of the three
                         dropdowns - and, per the same request, an icon (upward arrow into a tray)
                         instead of the word "Upload", matching every other button in this row.
                         Uploads exactly the boss the Mob/Boss filter is currently showing - hidden
                         in the Loot view and whenever there's nothing recorded yet, both still
                         handled the same way by RefreshUploadAvailability regardless of where the
                         button physically sits. -->
                    <Button x:Name="UploadBossButton" Style="{StaticResource ToolbarIconButton}" Click="OnUploadCurrentBossClicked" Padding="6,4"
                            Visibility="Collapsed"
                            ToolTip="Uploads this boss fight to dpsmeter.skeeve.tv.">
                        <Path Data="M9,2 L9,10 M4,7 L9,2 L14,7 M3,13 L15,13"
                              Stroke="#e8e8ea" StrokeThickness="1.6" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="18" Height="15" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Filter row: three dropdowns, matching the myaion.eu reference exactly (class
                     list uses its internal names Bard/Gunner/Painter, not the "modern"
                     Songweaver/Gunslinger - Painter itself is a post-4.6 class per the user, kept
                     here only for parity with the reference, marked in its tooltip). ClassFilter
                     was decorative-only until classes started being detected for players besides
                     "You" (see MainWindow.ResolveClassName) - now real, per the user: an empty
                     grid when nobody of the picked class is present is correct, not a bug. The
                     Mob/Boss filter below was already real before that. -->
                <!-- Labels removed per the user ("Die Worte VOR den Dropdowns können weg") - each
                     dropdown's own ToolTip plus, for ClassFilter now, the visible class name inside
                     it, carries enough meaning without a preceding "Class:"/"Source:"/"Mob/Boss:"
                     text label. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#1e1e24">
                    <!-- Icon + class name, per the user ("das Dropdown darf die Namen enthalten") -
                         previously icon-only; ClassIconConverter/pack://siteoforigin remarks that
                         used to sit here now live on NewCharacterClassBox in SettingsWindow.xaml,
                         which needed the identical icon-visibility fix and still explains it. -->
                    <!-- AutomationProperties.Name on every entry below: found by terminal_windows
                         trying to drive this dropdown by name for testing - a ComboBoxItem whose
                         Content is a visual tree (icon + TextBlock, not a plain string) doesn't
                         automatically expose that TextBlock's text as its automation name, so
                         every entry but "All" (plain string Content) read back empty or as the
                         raw type name. Same gap would affect a screen reader, not just test
                         tooling - explicit Name fixes both with the same one-liner. -->
                    <ComboBox x:Name="ClassFilter" SelectedIndex="0" Margin="6,0,0,0" SelectionChanged="OnClassFilterChanged">
                        <ComboBoxItem Content="{local:Loc Main.FilterAll}"/>
                        <ComboBoxItem Tag="Aethertech" AutomationProperties.Name="Aethertech"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Aethertech.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Aethertech" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Assassin" AutomationProperties.Name="Assassin"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Assassin.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Assassin" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Bard" AutomationProperties.Name="Bard"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Bard.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Bard" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Chanter" AutomationProperties.Name="Chanter"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Chanter.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Chanter" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Cleric" AutomationProperties.Name="Cleric"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Cleric.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Cleric" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Gladiator" AutomationProperties.Name="Gladiator"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Gladiator.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Gladiator" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Gunner" AutomationProperties.Name="Gunner"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Gunner.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Gunner" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <!-- Painter is a post-4.6 class, kept only for parity with the myaion.eu
                             reference - not expected to actually occur on a 4.6 server. -->
                        <ComboBoxItem Tag="Painter" AutomationProperties.Name="Painter"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Painter.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Painter" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Ranger" AutomationProperties.Name="Ranger"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Ranger.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Ranger" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Sorcerer" AutomationProperties.Name="Sorcerer"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Sorcerer.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Sorcerer" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Spiritmaster" AutomationProperties.Name="Spiritmaster"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Spiritmaster.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Spiritmaster" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="Templar" AutomationProperties.Name="Templar"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/assets/classes/icons/Templar.png" Height="18" Margin="0,0,4,0"/><TextBlock Text="Templar" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                    </ComboBox>
                    <!-- Placeholder: a DISPLAY filter only, collection always keeps everyone's
                         damage regardless of this setting. Needs group/legion/race data we don't
                         decode yet. -->
                    <ComboBox x:Name="SourceFilter" SelectedIndex="0" Margin="8,0,0,0"
                              ToolTip="Not wired up yet (display filter only).">
                        <ComboBoxItem Content="{local:Loc Main.FilterAll}"/>
                        <ComboBoxItem Content="{local:Loc Main.FilterSelf}"/>
                        <ComboBoxItem Content="{local:Loc Main.FilterGroup}"/>
                        <ComboBoxItem Content="{local:Loc Main.FilterAlliance}"/>
                        <ComboBoxItem Content="{local:Loc Main.FilterLegion}"/>
                        <ComboBoxItem Content="Elyos"/>
                        <ComboBoxItem Content="Asmodian"/>
                    </ComboBox>
                    <!-- Lists targets actually seen this session. "All" sums each source's damage
                         across every target (the ambiguous wall-clock view - see DpsCalculator
                         remarks); picking one target switches DPS to true per-target iDPS. -->
                    <ComboBox x:Name="MobBossFilter" Style="{StaticResource SearchableComboBox}"
                              SelectedIndex="0" SelectionChanged="OnMobBossFilterChanged" Margin="8,0,0,0"
                              ToolTip="Filter by target. 'All' sums damage across every target seen. Type in the dropdown to search.">
                        <ComboBoxItem Content="{local:Loc Main.FilterAll}"/>
                    </ComboBox>
                </StackPanel>

                <!-- Bottom status row, per the user: connection/Chat.log status removed ("Die Infos
                     im Footer können weg"), replaced with the personal stat row the ARM reference
                     shows there instead (Exp/AP/GP/Kinah). All four are real now: confirmed by
                     terminal_windows against real Chat.log lines that it narrates them as plain
                     sentences just like damage/heal ("You have gained N Abyss/Glory Points.",
                     "You have earned/spent N Kinah.", "You have gained N XP from <Mob>.") - see
                     ChatLogParser.PersonalStatChanged. GP took longer to confirm only because the
                     validation session hadn't produced any GP activity yet at the time it was
                     checked - once the user recalled a specific quest reward, terminal_windows
                     found "You have gained 100 Glory Points." right where expected. The old
                     ServerStatusDot/Text and ChatLogStatusDot/Text (connection state) aren't shown
                     anywhere else now - Chat.log validity is still visible in Settings'
                     AionInstallFolderStatus if that needs checking. -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Background="#26262e" Height="26">
                    <TextBlock Text="{local:Loc Main.StatExp}" Foreground="#9a9aa2" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBlock x:Name="ExpValueText" Text="-" Foreground="#c8c8ce" VerticalAlignment="Center"/>
                    <TextBlock Text="{local:Loc Main.StatAp}" Foreground="#9a9aa2" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBlock x:Name="ApValueText" Text="-" Foreground="#c8c8ce" VerticalAlignment="Center"/>
                    <TextBlock Text="{local:Loc Main.StatGp}" Foreground="#9a9aa2" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBlock x:Name="GpValueText" Text="-" Foreground="#c8c8ce" VerticalAlignment="Center"/>
                    <TextBlock Text="{local:Loc Main.StatKinah}" Foreground="#9a9aa2" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBlock x:Name="KinahValueText" Text="-" Foreground="#c8c8ce" VerticalAlignment="Center"/>

                    <!-- Only appears once Chat.log passes the threshold. In the status row rather
                         than as a popup for the same reason as the update notice: this window sits
                         on top of a running game, and nothing here is urgent enough to steal focus
                         from a fight. -->
                    <TextBlock x:Name="ChatLogSizeWarning" Visibility="Collapsed" VerticalAlignment="Center"
                               Margin="16,0,8,0" Foreground="#f0b71c" FontWeight="Bold" Cursor="Hand"
                               MouseLeftButtonUp="OnEmptyChatLogClicked"
                               ToolTip="Aion never trims Chat.log by itself. Click to empty it."/>

                    <!-- Update notice. Deliberately a quiet line in the status row and NOT a
                         popup: the meter sits on top of a running game, and a modal dialog
                         appearing mid-boss because a background timer fired would steal focus
                         from the fight. It only becomes visible when there is something to say,
                         and clicking it is what starts anything. -->
                    <TextBlock x:Name="UpdateNotice" Visibility="Collapsed" VerticalAlignment="Center"
                               Margin="16,0,8,0" Foreground="#69e15e" Cursor="Hand"
                               MouseLeftButtonUp="OnUpdateNoticeClicked"
                               TextDecorations="Underline"
                               ToolTip="A newer version is available - click to download and install it."/>

                    <!-- Quiet result line for the two upload actions (Session menu + the Damage
                         view's Upload button) - same reasoning as UpdateNotice above: this window
                         sits on top of a running fight, so a result never pops a modal dialog. -->
                    <TextBlock x:Name="UploadStatusText" Visibility="Collapsed" VerticalAlignment="Center"
                               Margin="16,0,8,0" Foreground="#9a9aa2"/>
                </StackPanel>

                <!-- Left nav rail: mirrors MyAion's 5 view icons. Only "Damage Distribution" has a
                     real data source right now (Combat/LiveAggregator) - the rest are
                     placeholders, not fake functionality, until their packet sources exist
                     (skill-cast order, loot events, equipment/profile packets, cross-encounter
                     instance aggregation). See README's UI-placeholders section. -->
                <StackPanel DockPanel.Dock="Left" Background="#26262e">
                    <Button Style="{StaticResource NavButton}" Content="{local:Loc Main.NavRot}" ToolTip="Skill Rotation (not implemented - needs skill-cast-order tracking)" IsEnabled="False"/>
                    <Button x:Name="DamageNavButton" Style="{StaticResource NavButton}" Content="{local:Loc Main.NavDmg}" ToolTip="Damage Distribution" Click="OnShowDamageView" FontWeight="Bold"/>
                    <!-- Real now, per the user - "You have acquired [item:ID;...]." lines parsed
                         by ChatLogParser.LootAcquired, item names resolved via Data/ItemDatabase
                         (see assets/README.md for its aioncodex.com "/4x/" source). -->
                    <Button x:Name="LootNavButton" Style="{StaticResource NavButton}" Content="{local:Loc Main.NavLoot}" ToolTip="Loot Table" Click="OnShowLootView"/>
                    <Button Style="{StaticResource NavButton}" Content="{local:Loc Main.NavChar}" ToolTip="Character Profile (not implemented - needs equipment/stat packet decoding)" IsEnabled="False"/>
                    <Button Style="{StaticResource NavButton}" Content="{local:Loc Main.NavInst}" ToolTip="Instance Scores (not implemented - needs cross-encounter aggregation + boss detection)" IsEnabled="False"/>
                </StackPanel>

                <DataGrid x:Name="PlayersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#1e1e24" Foreground="#e8e8ea" RowBackground="#22222a" AlternatingRowBackground="#26262e"
                          BorderBrush="#3a3a45" HorizontalGridLinesBrush="#3a3a45"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserAddRows="False">
                    <!-- Enemy rows get a dark red ground. A trigger rather than a converter so it
                         overrides RowBackground AND AlternatingRowBackground above: those are set
                         on the DataGrid itself and would otherwise win on every second row, which
                         would make the marking look like it came and went at random. -->
                    <!-- Right-click menu per row. Faction is correctable by hand because the log
                         cannot always answer it: in an arena the opponent is frequently the SAME
                         faction, and fighting someone only ever proves hostility, never which
                         banner they fight under. -->
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#26262e" Foreground="#e8e8ea">
                            <MenuItem Header="Details anzeigen" Click="OnShowPlayerDetailsClicked"/>
                            <Separator/>
                            <MenuItem Header="Fraktion wechseln" Click="OnSwitchFactionClicked"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                    <Setter Property="Background" Value="#4a1f24"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <!-- Found by terminal_windows measuring rendered pixels: clicking a row lit it
                         up #F0F0F0 - the default DataGridCell template pulls its selected-state
                         colors from SystemColors.Highlight*, which ignores the window's own
                         Background/Foreground entirely. Overriding those brush keys, scoped to
                         just this DataGrid rather than the whole window, recolors the built-in
                         selection visuals without touching anything else that might reference the
                         same system keys (e.g. a MenuItem's own highlight). -->
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3a3a45"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#e8e8ea"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3a3a45"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#e8e8ea"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- Column widths trimmed slightly (Level 50->40) after terminal_windows
                             measured the grid at only 1px of clearance from the window edge - zero
                             margin for a different DPI scaling or a future column, now ~30px of
                             buffer instead. -->
                        <!-- Class no longer has its own column, per the user: the icon sits right
                             before the name in this single column instead (StackPanel, icon then
                             TextBlock) - one less column to fit, and class/name read as one unit
                             the way a character actually presents. Icon falls back to nothing (no
                             icon, no crash) for "?" or any class name without a matching
                             assets/classes/icons/*.png - see ClassIconConverter. -->
                        <!-- Widths restored/saved by MainWindow (see RestoreWindowGeometry/
                             SaveWindowGeometry) - the 179/124 defaults here match what the user
                             last resized them to, measured live by terminal_windows since a
                             manual column drag isn't saved anywhere until the window closes. -->
                        <DataGridTemplateColumn x:Name="NameColumn" Header="{local:Loc Main.ColumnName}" Width="179">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Height/Width="18" here are load-bearing, not decorative:
                                             confirmed by terminal_windows that WPF reserves this
                                             fixed slot in the StackPanel even when the converter
                                             returns null (unknown/"?" class, no icon file) - that's
                                             the only reason every row's name lines up at the same
                                             x regardless of whether it has a class icon. Removing
                                             the explicit size (e.g. "the image is 18px anyway") would
                                             collapse the slot to zero width for every classless row
                                             and misalign the names. -->
                                        <!-- Faction emblem first, then class, then the name. Fixed
                                             size for the same reason as the class icon below: an
                                             unclassified player (nobody has healed or fought them
                                             yet) has no emblem, and without a reserved slot every
                                             such row's name would sit 22px to the left of the rest. -->
                                        <Image Source="{Binding Faction, Converter={StaticResource RaceIconConverter}}"
                                               Height="18" Width="18" Margin="0,0,4,0" ToolTip="{Binding Faction}"/>
                                        <Image Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"
                                               Height="18" Width="18" Margin="0,0,4,0" ToolTip="{Binding ClassName}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Damage and DPS merged into one column per the user - originally two
                             stacked lines, now (per a later request) DPS sits on the SAME line as
                             Damage instead, and the second line shows AP gained so far instead
                             (populated for "You"'s row, and for any other player who looted a
                             relic - see PlayerRow.Ap remarks - blank for mob rows and players
                             with nothing to show, same empty-slot pattern as the class icon for
                             an unmatched class). The header still needs to say DPS vs
                             iDPS depending on the Mob/Boss filter (see OnMobBossFilterChanged,
                             unchanged logic). -->
                        <DataGridTemplateColumn x:Name="DpsColumn" Header="{local:Loc Main.ColumnDamageDps}" Width="124">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Damage, StringFormat=N0}"/>
                                            <TextBlock Text="{Binding DpsDisplay}" Foreground="#9a9aa2" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ApDisplay}" Foreground="#9a9aa2" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loot view, hidden by default (OnShowDamageView/OnShowLootView toggle which of
                     the two grids is visible) - shows the WHOLE group's tracked acquisitions (see
                     MainWindow.OnLootAcquired remarks), item names via Data/ItemDatabase. Only
                     Godstones/Designs/Recipes plus Unique(Gold)+ grade items are tracked at all
                     (see IsTrackedLoot) - per the user, not every single drop. -->
                <DataGrid x:Name="LootGrid" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed"
                          Background="#1e1e24" Foreground="#e8e8ea" RowBackground="#22222a" AlternatingRowBackground="#26262e"
                          BorderBrush="#3a3a45" HorizontalGridLinesBrush="#3a3a45"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3a3a45"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#e8e8ea"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3a3a45"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#e8e8ea"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{local:Loc Main.ColumnPerson}" Binding="{Binding Person}" Width="90"/>
                        <!-- Colored by rarity grade, per the user ("mit Farbe") - same exact
                             colors Aion itself uses (see ItemGradeColorConverter), not a generic
                             text color. A grade-less row (id ItemDatabase has no entry for at all)
                             renders muted rather than any rarity color, since it has none. -->
                        <DataGridTemplateColumn Header="{local:Loc Main.ColumnItem}" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center"
                                               Foreground="{Binding Grade, Converter={StaticResource ItemGradeColorConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{local:Loc Main.ColumnQty}" Binding="{Binding Quantity, StringFormat=N0}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ================= Hide-UI overlay mode ================= -->
        <!-- Collapsed by default. Everything behind the window shows through (Window.Background
             is Transparent and NormalContent is hidden while this is visible); only a small dark
             chip per player stays visible. See OnHideUiClicked / NativeOverlay.cs for the
             click-through + hotkey handling that makes this safe to use over the actual game
             window.
             Per the user ("im Transparenten Modus identisch anzeigen, nur ohne UI Rahmen"): each
             chip now mirrors PlayersGrid's own two columns - faction + class icon, name, then
             Damage/DPS on one line with the RelicAp line underneath - instead of the old single
             "Name: Damage dmg (DPS)" text line, so switching modes doesn't also change what
             information is visible. It's the same content minus the window chrome (title bar,
             menu, toolbar, column headers, borders), not a different view. -->
        <ItemsControl x:Name="OverlayContent" Visibility="Collapsed" Background="Transparent"
                      HorizontalAlignment="Left" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="2" Padding="6,3" CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#99000000"/>
                                <Style.Triggers>
                                    <!-- Same rule as PlayersGrid.RowStyle, so an enemy row reads
                                         the same way in both modes. -->
                                    <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                        <Setter Property="Background" Value="#994a1f24"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Faction, Converter={StaticResource RaceIconConverter}}"
                                       Height="16" Width="16" Margin="0,0,4,0"/>
                                <Image Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"
                                       Height="16" Width="16" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Damage, StringFormat=N0}" Foreground="White"
                                           FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DpsDisplay}" Foreground="#c8c8ce" FontSize="10"
                                           Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ApDisplay}" Foreground="#c8c8ce" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
