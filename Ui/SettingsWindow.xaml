<Window x:Class="AionSniffer.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Settings" Height="480" Width="420"
        Background="#1e1e24" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="Margin" Value="4,3"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#c8c8ce"/>
            <Setter Property="BorderBrush" Value="#3a3a45"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#c8c8ce"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2a2a33"/>
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Click="OnSaveClicked"/>
            <Button Content="Cancel" Click="OnCancelClicked"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Every checkbox here has a matching field in Combat/*.cs or Ui/PlayerRow.cs
                     already -- this dialog deliberately does NOT include MyAion's Loot Table,
                     Kinah tracking, Auto-upload, or Donation Goal sections: none of those have a
                     packet source or backend wired up yet (see README's UI-placeholders
                     section), and an inert checkbox that looks functional but does nothing is
                     worse than no checkbox at all. -->
                <GroupBox Header="Target (NPC) Bar">
                    <StackPanel>
                        <CheckBox x:Name="ShowAutoDetectedRankedBossesBox" Content="Display auto detected ranked bosses"/>
                        <CheckBox x:Name="ShowManuallySelectedTargetBox" Content="Display manually selected target"/>
                        <CheckBox x:Name="ShowAutoDetectedTargetBox" Content="Display auto detected target"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Players List">
                    <StackPanel>
                        <CheckBox x:Name="ShowDpsBox" Content="Display DPS (Damage Per Second)"/>
                        <CheckBox x:Name="ShowLevelBox" Content="Display Level"/>
                        <TextBlock Text="Legion / Position / Unassigned Damage: not shown -- no data source yet"
                                   FontStyle="Italic" Margin="4,2" TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Targets List (which ranks are shown at all)">
                    <StackPanel>
                        <CheckBox x:Name="ShowPlayersBox" Content="Display players"/>
                        <CheckBox x:Name="ShowMinionNpcsBox" Content="Display minion NPCs (servants, summons, energies)"/>
                        <CheckBox x:Name="ShowCommonNpcsBox" Content="Display common NPCs"/>
                        <CheckBox x:Name="ShowEliteNpcsBox" Content="Display elite NPCs"/>
                        <CheckBox x:Name="ShowHeroicNpcsBox" Content="Display heroic NPCs"/>
                        <CheckBox x:Name="ShowLegendaryNpcsBox" Content="Display legendary NPCs"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="User Interface">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Theme:" VerticalAlignment="Center" Width="80"/>
                            <ComboBox x:Name="ThemeBox" Width="150">
                                <ComboBoxItem Content="Dark"/>
                                <ComboBoxItem Content="Light"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Font Size:" VerticalAlignment="Center" Width="80"/>
                            <ComboBox x:Name="FontSizeBox" Width="150">
                                <ComboBoxItem Content="Small"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="Large"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
