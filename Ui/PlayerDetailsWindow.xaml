<Window x:Class="AionSniffer.Ui.PlayerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Character Details" Height="460" Width="720"
        xmlns:local="clr-namespace:AionSniffer.Ui"
        Background="#1e1e24" Foreground="#e8e8ea" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:ClassIconConverter x:Key="ClassIconConverter"/>
        <local:RaceIconConverter x:Key="RaceIconConverter"/>
    </Window.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Faction, Converter={StaticResource RaceIconConverter}}"
                       Height="22" Width="22" Margin="0,0,4,0" ToolTip="{Binding Faction}"/>
                <Image Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"
                       Height="22" Width="22" Margin="0,0,8,0" ToolTip="{Binding ClassName}"/>
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="SummaryText" Foreground="#9a9aa2" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Says plainly where the crit column's numbers come from. For anyone but the local player
             they are estimated from the damage spread, because Aion only flags crits properly in
             the log of the player who scored them. A column that quietly mixed measured and
             estimated values would be worse than no column. -->
        <TextBlock x:Name="CritNoteText" DockPanel.Dock="Bottom" Foreground="#9a9aa2"
                   TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic"/>

        <DataGrid x:Name="SkillsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1e1e24" Foreground="#e8e8ea" RowBackground="#22222a"
                  AlternatingRowBackground="#26262e" BorderBrush="#3a3a45"
                  HorizontalGridLinesBrush="#3a3a45" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Skill" Binding="{Binding Skill}" Width="*"/>
                <DataGridTextColumn Header="Hits" Binding="{Binding Hits, StringFormat=N0}" Width="60"/>
                <DataGridTextColumn Header="Crit %" Binding="{Binding CritRate, StringFormat={}{0:F1}%}" Width="70"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N0}" Width="100"/>
                <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat=N0}" Width="80"/>
                <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat=N0}" Width="80"/>
                <DataGridTextColumn Header="Avg" Binding="{Binding Average, StringFormat=N0}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
