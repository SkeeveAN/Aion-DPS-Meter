<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme - generated palette, one Color.* and matching Brush.* per token.
         Consumed via {DynamicResource Brush.X} across Ui/*.xaml; swapped at runtime by
         Ui/ThemeManager.cs. Keep every theme defining the same token set (SelfCheck enforces it). -->
    <Color x:Key="Color.Window">#F4F4F7</Color>
    <Color x:Key="Color.TitleBar">#E4E4EA</Color>
    <Color x:Key="Color.Panel">#ECECF0</Color>
    <Color x:Key="Color.RowAlt">#F0F0F4</Color>
    <Color x:Key="Color.Control">#E0E0E7</Color>
    <Color x:Key="Color.ControlRaised">#D8D8E0</Color>
    <Color x:Key="Color.ControlHover">#CFCFD8</Color>
    <Color x:Key="Color.ControlHoverStrong">#C2C2CC</Color>
    <Color x:Key="Color.Border">#BCBCC6</Color>
    <Color x:Key="Color.ScrollThumb">#A4A4B0</Color>
    <Color x:Key="Color.CheckBorder">#9494A2</Color>
    <Color x:Key="Color.CheckBorderHover">#70708A</Color>
    <Color x:Key="Color.TextDisabled">#9A9AA2</Color>
    <Color x:Key="Color.TextMuted">#5C5C68</Color>
    <Color x:Key="Color.TextSubtle">#3A3A48</Color>
    <Color x:Key="Color.Text">#1E1E24</Color>
    <Color x:Key="Color.Accent">#2F9A2A</Color>
    <Color x:Key="Color.RowEnemy">#F2CFD3</Color>
    <Color x:Key="Color.OverlayBg">#99000000</Color>
    <Color x:Key="Color.OverlayEnemy">#994A1F24</Color>
    <Color x:Key="Color.OverlayText">#FFFFFF</Color>
    <Color x:Key="Color.Warning">#A87800</Color>
    <Color x:Key="Color.WarningSoft">#B06A10</Color>
    <Color x:Key="Color.Danger">#C62F38</Color>
    <Color x:Key="Color.DangerSoft">#C97878</Color>
    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="Brush.TitleBar" Color="{StaticResource Color.TitleBar}"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="{StaticResource Color.RowAlt}"/>
    <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}"/>
    <SolidColorBrush x:Key="Brush.ControlRaised" Color="{StaticResource Color.ControlRaised}"/>
    <SolidColorBrush x:Key="Brush.ControlHover" Color="{StaticResource Color.ControlHover}"/>
    <SolidColorBrush x:Key="Brush.ControlHoverStrong" Color="{StaticResource Color.ControlHoverStrong}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource Color.ScrollThumb}"/>
    <SolidColorBrush x:Key="Brush.CheckBorder" Color="{StaticResource Color.CheckBorder}"/>
    <SolidColorBrush x:Key="Brush.CheckBorderHover" Color="{StaticResource Color.CheckBorderHover}"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextSubtle" Color="{StaticResource Color.TextSubtle}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.RowEnemy" Color="{StaticResource Color.RowEnemy}"/>
    <SolidColorBrush x:Key="Brush.OverlayBg" Color="{StaticResource Color.OverlayBg}"/>
    <SolidColorBrush x:Key="Brush.OverlayEnemy" Color="{StaticResource Color.OverlayEnemy}"/>
    <SolidColorBrush x:Key="Brush.OverlayText" Color="{StaticResource Color.OverlayText}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}"/>
</ResourceDictionary>
